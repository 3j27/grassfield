{
 "_doc": [
  "Text roles of the shell for the exact token calculation of gate A2 (tests/visual/test_contrast_tokens.py).",
  "fg: <palette>.<colour token> (palette colors = the current appearance, darkColors = always dark). opacity: factors applied to the",
  "text alpha (numbers or token paths such as search.selectedSubtitleOpacity). backdrop: material (tint at 1 - t*(1-tintAlphaMin) over a",
  "flat wallpaper colour, with and without a fill overlay), accent (solid accent), apps (black dim over the wallpaper), apps-field",
  "(dim + the Apps search field fill), rename-field (colors.fieldFill at desktopIcon.renameFillOpacity over the wallpaper), desktop-label (shadow colour at desktopIcon.labelShadowOpacity over the wallpaper: conservative core of",
  "the drop shadow). kind: text >= 4.5, large|icon >= 3.0. exempt: reason, the role is listed but not asserted (a disabled control, or a",
  "surface outside the A2 scope that is tracked as an open finding in docs/testing/visual.md).",
  "sites: where the role is used in QML. A file x class count is cross-checked against shell/ and ui/Grassfield/ by the same test, so a new",
  "textSecondary / withAlpha text / text-with-opacity / danger-text use without a role fails. classes: secondary (any [dark]colors.textSecondary),",
  "alpha (withAlpha of text/accentText), opacity (a Text item with an opacity property), danger (any colors.danger use, text or graphic)."
 ],
 "roles": [
  {"id": "text on material", "fg": "colors.text", "backdrop": "material", "kind": "text", "sites": []},
  {"id": "secondary on material", "fg": "colors.textSecondary", "backdrop": "material", "kind": "text", "sites": [
   {"file": "shell/notifications/NotificationContent.qml", "class": "secondary", "count": 1},
