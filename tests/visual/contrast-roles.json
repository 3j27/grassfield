   {"file": "shell/widgets/builtin/calendar/Calendar.qml", "class": "secondary", "count": 2},
   {"file": "shell/widgets/builtin/system/System.qml", "class": "secondary", "count": 2},
   {"file": "shell/widgets/builtin/nowplaying/NowPlaying.qml", "class": "secondary", "count": 3},
   {"file": "ui/Grassfield/Ui/MenuItem.qml", "class": "secondary", "count": 1}
  ]},
  {"id": "danger text on material", "fg": "colors.danger", "backdrop": "material", "kind": "text", "sites": [
   {"file": "shell/notifications/NotificationContent.qml", "class": "danger", "count": 1},
   {"file": "shell/security/polkit/AuthDialog.qml", "class": "danger", "count": 1},
   {"file": "ui/Grassfield/Ui/Button.qml", "class": "danger", "count": 1},
   {"file": "ui/Grassfield/Ui/MenuItem.qml", "class": "danger", "count": 1}
  ]},
  {"id": "danger graphic on material", "fg": "colors.danger", "backdrop": "material", "kind": "icon", "sites": [
   {"file": "shell/widgets/builtin/battery/Battery.qml", "class": "danger", "count": 1},
   {"file": "shell/widgets/builtin/system/System.qml", "class": "danger", "count": 1}
  ]},
  {"id": "accent text on accent", "fg": "colors.accentText", "backdrop": "accent", "kind": "text", "sites": []},
  {"id": "search selected subtitle on accent", "fg": "colors.accentText", "opacity": ["search.selectedSubtitleOpacity"], "backdrop": "accent", "kind": "text", "sites": [
   {"file": "shell/search/SearchPanel.qml", "class": "alpha", "count": 1}
  ]},
  {"id": "desktop label (white, shadow)", "fg": "darkColors.text", "backdrop": "desktop-label", "kind": "text", "sites": []},
  {"id": "desktop label error (shadow)", "fg": "darkColors.danger", "backdrop": "desktop-label", "kind": "text", "sites": [
   {"file": "shell/desktop/DesktopIcon.qml", "class": "danger", "count": 2}
  ]},
  {"id": "rename field text", "fg": "colors.fieldText", "backdrop": "rename-field", "kind": "text", "sites": []},
  {"id": "apps label", "fg": "darkColors.text", "backdrop": "apps", "kind": "text", "sites": []},
  {"id": "apps search field glyph and placeholder", "fg": "darkColors.textSecondary", "backdrop": "apps-field", "kind": "text", "sites": [
   {"file": "shell/launchpad/AppsWindow.qml", "class": "secondary", "count": 2}
  ]},
  {"id": "apps label (drag source ghost)", "fg": "darkColors.text", "opacity": ["apps.dragSourceOpacity"], "backdrop": "apps", "kind": "text",
   "exempt": "the cell an item is dragged from is a faded ghost; the dragged item itself is shown at full opacity under the pointer",
   "sites": [{"file": "shell/launchpad/AppsCell.qml", "class": "opacity", "count": 1}]},
  {"id": "overview captions (dim over wallpaper)", "fg": "colors.textSecondary", "backdrop": "material", "kind": "text",
   "exempt": "Overview Spaces strip sits on a black dim over the wallpaper, not on material: outside the A2 scope of this pass, open finding in docs/testing/visual.md",
   "sites": [{"file": "shell/overview/OverviewWindow.qml", "class": "secondary", "count": 1}]},
  {"id": "disabled text", "fg": "colors.textSecondary", "opacity": ["material.disabledOpacity"], "backdrop": "material", "kind": "text",
   "exempt": "disabled or inactive component: exempt from WCAG 1.4.3",
   "sites": [
    {"file": "shell/widgets/builtin/calendar/Calendar.qml", "class": "secondary", "count": 1},
    {"file": "shell/menubar/MenuBar.qml", "class": "alpha", "count": 1},
    {"file": "ui/Grassfield/Ui/MenuItem.qml", "class": "alpha", "count": 1}
  ]}
 ]
}
