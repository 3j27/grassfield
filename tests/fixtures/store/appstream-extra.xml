    <name>Gone</name>
  </component>
  <component type="console-application">
    <id>org.example.Cli</id>
    <pkgname>cli-tool</pkgname>
    <name>Cli</name>
  </component>
  <component type="desktop-application">
    <id>org.example.NoPackage</id>
    <name>No package</name>
  </component>
  <component type="desktop-application">
