      <rect x="15" y="4" width="2" height="6.4" rx="1" opacity="0.14" transform="rotate(-330 16 16)"/>
    </g>
  </defs>
  <use href="#a" fill="{{OUTLINE}}" stroke="{{OUTLINE}}" stroke-width="3" stroke-linejoin="round"/>
  <use href="#b" fill="{{OUTLINE}}" stroke="{{OUTLINE}}" stroke-width="4.4" stroke-linejoin="round"/>
