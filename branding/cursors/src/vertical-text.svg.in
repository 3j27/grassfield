    <rect x="14.9" y="5.5" width="2.2" height="21" rx="1.1"/>
    <rect x="11.2" y="4.4" width="9.6" height="2.2" rx="1.1"/>
    <rect x="11.2" y="25.4" width="9.6" height="2.2" rx="1.1"/>
  </g></defs>
  <use href="#s" fill="{{OUTLINE}}" stroke="{{OUTLINE}}" stroke-width="2.8" stroke-linejoin="round"/>
  <use href="#s" fill="{{FILL}}"/>
</svg>
