<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <!-- Grassfield cursor: busy spinner. 12 frames; the build substitutes {{ANGLE}} (0, 30, ... 330). Hotspot (16,16). -->
  <defs><g id="s" transform="rotate({{ANGLE}} 16 16)">
    <rect x="15" y="4" width="2" height="6.4" rx="1" opacity="1.00" transform="rotate(0 16 16)"/>
    <rect x="15" y="4" width="2" height="6.4" rx="1" opacity="0.92" transform="rotate(-30 16 16)"/>
    <rect x="15" y="4" width="2" height="6.4" rx="1" opacity="0.84" transform="rotate(-60 16 16)"/>
    <rect x="15" y="4" width="2" height="6.4" rx="1" opacity="0.76" transform="rotate(-90 16 16)"/>
    <rect x="15" y="4" width="2" height="6.4" rx="1" opacity="0.68" transform="rotate(-120 16 16)"/>
    <rect x="15" y="4" width="2" height="6.4" rx="1" opacity="0.60" transform="rotate(-150 16 16)"/>
    <rect x="15" y="4" width="2" height="6.4" rx="1" opacity="0.52" transform="rotate(-180 16 16)"/>
    <rect x="15" y="4" width="2" height="6.4" rx="1" opacity="0.44" transform="rotate(-210 16 16)"/>
    <rect x="15" y="4" width="2" height="6.4" rx="1" opacity="0.36" transform="rotate(-240 16 16)"/>
    <rect x="15" y="4" width="2" height="6.4" rx="1" opacity="0.28" transform="rotate(-270 16 16)"/>
    <rect x="15" y="4" width="2" height="6.4" rx="1" opacity="0.20" transform="rotate(-300 16 16)"/>
    <rect x="15" y="4" width="2" height="6.4" rx="1" opacity="0.14" transform="rotate(-330 16 16)"/>
  </g></defs>
  <use href="#s" fill="{{OUTLINE}}" stroke="{{OUTLINE}}" stroke-width="2.8" stroke-linejoin="round"/>
  <use href="#s" fill="{{FILL}}"/>
</svg>
