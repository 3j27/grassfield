[Icon Theme]
Name=Grassfield
Comment=Grassfield app icon theme: Grassfield's own icons first, then WhiteSur (when installed), then Adwaita and hicolor
# Lookup order (depth first; Qt and GTK append hicolor last, and skip a parent that is not installed):
#   1. this theme's own directories (empty until the designer adds icons),
#   2. WhiteSur and its own parents (hicolor, breeze) when grassfield-whitesur-icons is installed,
#   3. Adwaita, then hicolor.
Inherits=WhiteSur,Adwaita,hicolor
# Not offered by theme pickers of other sessions. A session names the theme explicitly (ADR-0017).
Hidden=true
# GTK drops a theme whose index.theme has no Directories key, together with its Inherits (spike I0, ADR-0017): keep one
# real directory (scalable/apps) in the installed theme even while it holds no icon.
Directories=scalable/apps

[scalable/apps]
Context=Applications
Size=128
MinSize=8
MaxSize=512
Type=Scalable
