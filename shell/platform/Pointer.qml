pragma ComponentBehavior: Bound
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Hyprland
import Quickshell.Io
import Grassfield.Ui
import "Minimized.js" as Minimized

// Live pointer size and colours (Settings > Accessibility > Pointer, ADR-0014). The compositor is asked for a new size
// and theme with Hyprland's own `setcursor <theme> <size>` request, sent on the request socket of the instance this
// shell belongs to (Hyprland.requestSocketPath, i.e. the nested instance in a dev session, never another one).
// The theme is the session's (the packaged grassfield-cursors) for the default colours; for any other outline/fill pair
// it is grassfield-cursors-custom, regenerated by PointerTheme.qml (build.sh in a Process, debounced) and switched to
// once it is on disk; until then, and when the build fails, the pointer stays as it is. Reset Color (default colours)
// switches back to the session theme and deletes the custom one. A rebuilt theme under the same name is sent again
// (the compositor loads it again). Degrades quietly: not running under Hyprland (no socket) or no cursor theme to
// ask for (no session theme in the environment and no custom theme) means nothing is sent. No polling.
// Delivery: one fresh socket per request (a Quickshell Socket whose connect failed never connects again, so it is
// replaced, not reused). The size counts as applied only when Hyprland answered "ok". A lost request (no connection,
// no answer, another answer) is sent again after a growing wait, up to settingsPointerRetryMax attempts; then it waits
// for the next size change or for Hyprland to announce a config reload (which resets the cursor). No busy loop.
// While the slider is dragged, requests are throttled (leading edge, then the last value after the interval).
// With the compositor capability "cursor-refresh" (gfc/1) a refresh request follows each delivered size so the pointer
// on screen is redrawn at once; without it the new size shows at the next shape change.
// Applications already running keep the size they started with; the ones the shell starts get the size and the custom
// theme in their environment (launchEnvironment). At startup the stored size is sent as soon as the settings file is read.
// See docs/specs/settings.md, Pointer.
Singleton {
    id: root

    // Wanted size in pixels; bound to Settings.pointerSize by the shell.
    property int size: PointerSize.DEFAULT
    // Size of the session environment this shell started with (what applications started elsewhere hold).
    readonly property int sessionSize: PointerSize.normalize(parseInt(Quickshell.env("HYPRCURSOR_SIZE") || Quickshell.env("XCURSOR_SIZE") || "", 10))
    // Size the compositor has, as far as this shell knows: the session size at start, then every request it answered.
    property int applied: sessionSize
    // The theme the session selected (cursor.lua / uwsm finalize): the one used for the default colours.
    property string theme: Quickshell.env("HYPRCURSOR_THEME") || Quickshell.env("XCURSOR_THEME") || ""
    // Outline and fill colours (#rrggbb); bound to the settings by the shell.
    property string outlineColor: PointerColors.DEFAULT_OUTLINE
    property string fillColor: PointerColors.DEFAULT_FILL
    // Where the state of the theme build is written for the Settings app ("" = nowhere); bound by the shell.
    property string statusPath: ""
    readonly property alias builder: themeBuilder
    readonly property bool customColors: !PointerColors.isDefault(root.outlineColor, root.fillColor)
    // The theme the compositor should have now: the session's for the default colours; the custom one once built; until
    // then (or after a failed build) the one it has. Properties for observers; the logic below calls the functions, which
    // read the primary state (colours, builder plan, generation) and never a binding that may not have been re-evaluated yet.
    readonly property string wantedTheme: root.wantedThemeNow()
    // The theme the compositor has, as far as this shell knows ("" = the session's, until a request was answered).
    property string appliedTheme: ""
    // The build generation of the custom theme the compositor has loaded.
    property int appliedGeneration: 0
    readonly property int wantedGeneration: root.wantedGenerationNow()
    property string socketPath: Hyprland.requestSocketPath || ""
    readonly property bool available: root.availableNow()
    // Observable by tests: requests written, requests Hyprland answered "ok", refresh requests sent, last request line.
    property int sent: 0
    property int delivered: 0
    property int refreshed: 0
    property string lastRequest: ""
    // Attempts made for the current size (0 once delivered) and whether the retries ran out.
    property int attempts: 0
    property bool gaveUp: false

    // A change arrived during the throttle interval.
    property bool again: false
    // A request is on the wire: its size, the socket, the connection number (events of older ones are ignored), reply.
    property bool busy: false
    property int inflight: 0
    property string inflightTheme: ""
    property int inflightGeneration: 0
    property var conn: null
    property int serial: 0
    property string reply: ""
    property bool warned: false

    onSizeChanged: root.update()
    onAvailableChanged: root.update()
    onWantedThemeChanged: root.update()
    onWantedGenerationChanged: root.update()

    function currentTheme(): string {
        return root.appliedTheme !== "" ? root.appliedTheme : root.theme;
    }

    // The theme on disk is the one of the colours chosen now.
    function themeReady(): bool {
        const key = PointerColors.key(root.outlineColor, root.fillColor);
        return key !== "" && themeBuilder.plan.built === key;
    }

    function wantedThemeNow(): string {
        if (PointerColors.isDefault(root.outlineColor, root.fillColor))
            return root.theme;
        return root.themeReady() ? PointerColors.CUSTOM_THEME : root.currentTheme();
    }

    // The build of the custom theme to load: the finished one when the colours are built, else what is loaded (a rebuild
    // in progress asks for nothing).
    function wantedGenerationNow(): int {
        return !PointerColors.isDefault(root.outlineColor, root.fillColor) && root.themeReady() ? themeBuilder.generation : root.appliedGeneration;
    }

    function availableNow(): bool {
        return root.socketPath !== "" && root.wantedThemeNow() !== "";
    }

    // Environment for an application the shell starts: the size the user chose and the custom theme, each only when it
    // differs from the session's. The custom theme is given while it is wanted or on screen (after a failed rebuild the
    // pointer still has the previous colours, and a new app should match it).
    function launchEnvironment(): var {
        const custom = root.wantedThemeNow() === PointerColors.CUSTOM_THEME || root.currentTheme() === PointerColors.CUSTOM_THEME;
        return PointerSize.launchEnvironment(root.size, root.sessionSize, custom ? PointerColors.CUSTOM_THEME : "", root.theme);
    }

    // The compositor has what is wanted: size, theme, and the build of the custom theme.
    function inSync(): bool {
        const theme = root.wantedThemeNow();
        return root.size === root.applied && theme === root.currentTheme() && (theme !== PointerColors.CUSTOM_THEME || root.wantedGenerationNow() === root.appliedGeneration);
    }

    function update(): void {
        // Back to the default colours and the session theme in place: the custom theme is no longer needed.
        if (PointerColors.isDefault(root.outlineColor, root.fillColor) && root.wantedThemeNow() === root.currentTheme() && !root.busy)
            themeBuilder.removeTheme();
        if (root.inSync())
            return;
        if (!root.availableNow()) {
            if (!root.warned) {
                root.warned = true;
                console.info("grassfield-shell: pointer size not applied (no Hyprland request socket or no cursor theme in the environment)");
            }
            return;
        }
        // The answer or the pending retry sends the current size.
        if (root.busy || retry.running)
            return;
        if (throttle.running) {
            root.again = true;
            return;
        }
        root.attempts = 0;
        root.gaveUp = false;
        root.transmit();
        throttle.restart();
    }

    function transmit(): void {
        const theme = root.wantedThemeNow();
        const line = PointerSize.setCursorRequest(theme, root.size);
        if (line === "" || root.socketPath === "")
            return;
        root.busy = true;
        root.inflight = root.size;
        root.inflightTheme = theme;
        root.inflightGeneration = root.wantedGenerationNow();
        root.reply = "";
        root.lastRequest = line;
        root.sent++;
        console.info("grassfield-shell: pointer", line);
        const id = ++root.serial;
        const sock = socketFactory.createObject(root, {
            "serial": id,
            "path": root.socketPath,
            "line": line
        });
        root.conn = sock;
        watchdog.restart();
        sock.connected = true;
    }

    // Closes and discards the socket of the request on the wire; its late events are ignored.
    function drop(): void {
        watchdog.stop();
        root.serial++;
        const sock = root.conn;
        root.conn = null;
        if (sock) {
            sock.connected = false;
            sock.destroy();
        }
    }

    function succeed(): void {
        const size = root.inflight;
        root.drop();
        root.busy = false;
        root.applied = size;
        root.appliedTheme = root.inflightTheme;
        root.appliedGeneration = root.inflightGeneration;
        root.attempts = 0;
        root.gaveUp = false;
        root.delivered++;
        root.refresh();
        // The size changed meanwhile.
        root.update();
    }

    function fail(why: string): void {
        root.drop();
        root.busy = false;
        root.attempts++;
        if (root.attempts < Tokens.settingsPointerRetryMax) {
            retry.interval = PointerSize.retryDelay(Tokens.settingsPointerRetryMs, root.attempts);
            console.info("grassfield-shell: pointer request not delivered (" + why + "), retrying in " + retry.interval + " ms");
            retry.start();
        } else {
            root.gaveUp = true;
            console.info("grassfield-shell: pointer request not delivered (" + why + "), giving up until the size or the compositor changes");
        }
    }

    // Asks the plugin to redraw the cursor (gfc/1 "cursor-refresh"); nothing when the plugin does not have it.
    function refresh(): void {
        if (!Capabilities.has("cursor-refresh"))
            return;
        Hyprland.dispatch(Minimized.cursorRefreshCall());
        root.refreshed++;
    }

    function socketConnected(id: int): void {
        // Hyprland answers when it has handled the request, then closes.
        if (id === root.serial && root.busy)
            watchdog.restart();
    }

    function socketReply(id: int, data: string): void {
        if (id !== root.serial || !root.busy)
            return;
        root.reply += data;
        const text = root.reply.trim();
        if (text === "ok")
            root.succeed();
        else if (text !== "" && !"ok".startsWith(text))
            root.fail("the compositor answered: " + text.substring(0, 80));
    }

    function socketClosed(id: int, why: string): void {
        if (id !== root.serial || !root.busy)
            return;
        // A close after "ok" is handled in onReply; here nothing valid came.
        root.fail(why);
    }

    // The compositor reloaded its configuration: its cursor is back to the configured one.
    function compositorReset(): void {
        root.applied = root.sessionSize;
        root.appliedTheme = "";
        root.update();
    }

    // The theme build ended: the removal of an unneeded custom theme may be possible now.
    Connections {
        target: themeBuilder

        function onBuildingChanged(): void {
            root.update();
        }
    }

    PointerTheme {
        id: themeBuilder
        outline: root.outlineColor
        fill: root.fillColor
        statusPath: root.statusPath
    }

    Connections {
        target: Hyprland

        function onRawEvent(event: HyprlandEvent): void {
            if (event.name === "configreloaded")
                root.compositorReset();
        }
    }

    Timer {
        id: throttle
        interval: Tokens.settingsPointerApplyMs
        onTriggered: {
            if (root.again) {
                root.again = false;
                root.update();
            }
        }
    }

    // Waits before sending a lost request again (interval set by fail()).
    Timer {
        id: retry
        onTriggered: {
            if (!root.inSync() && root.availableNow() && !root.busy)
                root.transmit();
        }
    }

    // A request no one answered.
    Timer {
        id: watchdog
        interval: Tokens.settingsPointerAnswerMs
        onTriggered: root.fail("no answer")
    }

    // One connection per request.
    Component {
        id: socketFactory

        Socket {
            id: sock
            property int serial: 0
            property string line: ""
            parser: SplitParser {
                // No separator: Hyprland's "ok" has no newline, take what arrives.
                splitMarker: ""
                onRead: data => root.socketReply(sock.serial, data)
            }
            onConnectedChanged: {
                if (connected) {
                    write(sock.line);
                    flush();
                    root.socketConnected(sock.serial);
                } else {
                    root.socketClosed(sock.serial, "connection closed without an answer");
                }
            }
            // Connect failures arrive here (the LocalSocketError type is not importable for a typed handler).
            Component.onCompleted: sock.error.connect(() => root.socketClosed(sock.serial, "socket error"))
        }
    }
}
