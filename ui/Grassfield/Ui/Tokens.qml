    // ADR-0016: the fixed crossfade between two wallpapers of any kind (artwork, colour, picture; macOS: ASSUMPTION, check against design/reference); Reduce Motion makes it a plain switch
    readonly property int wallpaperCrossfadeMs: 1000
    // ADR-0016: a grassfield-wallpaper prepare that runs longer than this is killed (a 24 MP JPEG takes under a second)
    readonly property int wallpaperToolTimeoutMs: 30000
    // ADR-0016: a folder listing that runs longer than this is killed (a hung network mount never blocks the shell)
    readonly property int wallpaperListTimeoutMs: 10000
    // ADR-0016: quiet time after the last settings change before a picture is prepared (a colour well dragged for a second makes one job)
    readonly property int wallpaperChangeDebounceMs: 250
    // ADR-0016 (owner answers): LRU cap of the prepared-picture cache, 512 MiB
    readonly property int wallpaperCacheMaxBytes: 536870912
    // ADR-0016: pictures read from one folder
    readonly property int wallpaperMaxListEntries: 10000
    // ADR-0016: quiet time before the carousel position is written to the state file
    readonly property int wallpaperStateWriteMs: 500
    // ADR-0016 step 2: a grassfield-wallpaper fetch (three API requests and one picture, curl allows 60 s each) that runs longer than this is killed
    readonly property int wallpaperFetchTimeoutMs: 300000
    // ADR-0016 step 2: the online scheduler looks again at most this long after it went to sleep (the day's random slot lies within 6 h of 00:10 UTC)
    readonly property int wallpaperOnlineMaxWaitMs: 21600000
    // ADR-0016 step 2: a metered connection is asked about again after this long
    readonly property int wallpaperOnlineMeteredRecheckMs: 3600000
    // ADR-0016 step 2: the nmcli metered query that runs longer than this is killed and counted as not metered (a hung NetworkManager never blocks the fetch)
    readonly property int wallpaperMeteredTimeoutMs: 10000
    // ADR-0016 section 6: the lock screen draws a wallpaper still only when it is a regular file of at most this many bytes under the wallpaper cache (a prepared JPEG at 4K is a few MB; a PNG of a centred or tiled picture is the largest case)
    readonly property int wallpaperLockStillMaxBytes: 67108864
    // ADR-0016 section 5: a video wallpaper settles (rate eases to 0.25, then pauses) after this many idle seconds
    readonly property int wallpaperVideoIdleSeconds: 60
    // ADR-0016 section 5: the playback rate eases from 1 to the settle rate over this long when the user goes idle (macOS: the video slows down and comes to rest)
    readonly property int wallpaperVideoSettleMs: 2000
    // ADR-0016 section 5: the playback rate a video eases down to before it pauses
    readonly property real wallpaperVideoSettleRate: 0.25
    // ADR-0016 section 5: the crash marker is cleared after this long of uninterrupted playback
    readonly property int wallpaperVideoStableMs: 10000
    // ADR-0016 section 2: the longest video wallpaper (the helper refuses a longer one)
    readonly property int wallpaperVideoMaxSeconds: 600
    // ADR-0016 section 2: the largest transcoded video file (512 MiB)
    readonly property int wallpaperVideoMaxBytes: 536870912
    // ADR-0016 section 2: a grassfield-wallpaper transcode that runs longer than this is killed (the helper's own ffmpeg limit is 30 minutes)
    readonly property int wallpaperVideoToolTimeoutMs: 2400000
    // estimate: width of the About This Wallpaper card of the desktop menu (macOS shows a small panel of about this width) [ref: docs/testing/f1-reference-gaps.md § Desktop; docs/specs/desktop.md]
    readonly property int wallpaperAboutWidth: 360

