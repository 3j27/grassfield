{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grassfield.invalid/schema/grassfield-1.json",
  "title": "grassfield.json (contract version 1)",
  "description": "User configuration of Grassfield Desktop. Unknown keys are ignored by the shell; migrations are explicit (master-prompt §5.3).",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "appearance": {
      "type": "string",
      "enum": [
        "dark",
        "light",
        "auto"
      ]
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transparency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "profile": {
          "type": "string",
          "enum": [
            "full",
            "balanced",
            "reduced"
          ]
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reduceTransparency": {
          "type": "boolean"
        },
        "reduceMotion": {
          "type": "boolean"
        }
      }
    },
    "dock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pinned": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "size": {
          "type": "integer",
          "minimum": 32,
          "maximum": 96
        },
        "position": {
          "type": "string",
          "enum": [
            "left",
            "bottom",
            "right"
          ]
        },
        "magnification": {
          "type": "number",
          "minimum": 1,
          "maximum": 2.5
        },
        "autohide": {
          "type": "boolean"
        },
        "magnificationEnabled": {
          "type": "boolean"
        },
        "recent": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "showRecents": {
          "type": "boolean"
        },
        "minimizeIntoApp": {
          "type": "boolean"
        },
        "animateOpening": {
          "type": "boolean"
        },
        "showIndicators": {
          "type": "boolean"
        },
        "minimizeEffect": {
          "type": "string",
          "enum": [
            "funnel",
            "shrink"
          ]
        }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "titlebarDoubleClick": {
          "type": "string",
          "enum": [
            "zoom",
            "minimize",
            "none"
          ]
        },
        "tilingEdges": {
          "type": "boolean"
        },
        "tilingMenuBar": {
          "type": "boolean"
        },
        "tilingMargins": {
          "type": "boolean"
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dnd": {
          "type": "boolean"
        },
        "previews": {
          "type": "string",
          "enum": [
            "always",
            "unlocked",
            "never"
          ]
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idleMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240
        }
      }
    },
    "hotCorners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topLeft": {
          "type": "string",
          "enum": [
            "none",
            "overview",
            "notifications",
            "apps",
            "lock"
          ]
        },
        "topRight": {
          "type": "string",
          "enum": [
            "none",
            "overview",
            "notifications",
            "apps",
            "lock"
          ]
        },
        "bottomLeft": {
          "type": "string",
          "enum": [
            "none",
            "overview",
            "notifications",
            "apps",
            "lock"
          ]
        },
        "bottomRight": {
          "type": "string",
          "enum": [
            "none",
            "overview",
            "notifications",
            "apps",
            "lock"
          ]
        }
      }
    },
    "desktop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showIcons": {
          "type": "boolean"
        }
      }
    },
    "menubar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showBackground": {
          "type": "boolean"
        },
        "autoHide": {
          "type": "string",
          "enum": [
            "always",
            "desktop",
            "fullscreen",
            "never"
          ],
          "description": "Automatically hide and show the menu bar (Settings > Desktop & Dock > Menu Bar): \"always\" hides it on the desktop and in full screen, \"desktop\" on the desktop only, \"fullscreen\" (default) in full screen only, \"never\" keeps it in view. A hidden bar slides in over the window when the pointer reaches the top edge. Only \"fullscreen\" and \"never\" reserve space for the bar."
        },
        "showNowPlaying": {
          "type": "boolean",
          "description": "Show the Now Playing item in the menu bar while a media player has a session (playing, or paused with a track loaded). Default true."
        },
        "showSearch": {
          "type": "boolean",
          "description": "Show the Search item (magnifier) in the menu bar. Default true."
        }
      }
    },
    "accent": {
      "type": "object",
      "additionalProperties": false,
      "description": "Accent colour (Settings > Appearance > Accent colour). A nested `appearance.accent` cannot exist in contract version 1, where `appearance` is a string (the same reason as the `icons` keys, ADR-0014).",
      "properties": {
        "color": {
          "type": "string",
          "enum": [
            "multicolor",
            "blue",
            "purple",
            "pink",
            "red",
            "orange",
            "yellow",
            "green",
            "graphite"
          ],
          "description": "\"multicolor\" keeps each surface's own colour, for Grassfield the Grassfield green (default); the others replace the accent of menus, selections, toggles, focus rings and the Tinted and folder colours that follow it. The highlight colour (text selection) follows the accent."
        }
      }
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "description": "Icon appearance of Grassfield surfaces (ADR-0014): app and file icons only, never symbolic glyphs.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "default",
            "dark",
            "clear",
            "tinted"
          ]
        },
        "tint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(accent|#[0-9a-fA-F]{6})$",
          "description": "\"accent\" follows the accent colour, else a #rrggbb colour used by the tinted mode."
        },
        "folderColor": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(theme|accent|#[0-9a-fA-F]{6})$",
          "description": "Colour of every folder icon: \"theme\" keeps the icon theme's own colour, \"accent\" follows the accent colour, else a #rrggbb colour. A folder's own colour (Customize Folder) wins."
        }
      }
    },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pointer (Settings > Accessibility > Pointer, ADR-0014).",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 24,
          "maximum": 96,
          "description": "Cursor size in pixels (the macOS slider Normal to Large). Applied live by the shell; the XCursor fallback uses the nearest of 24, 32, 48, 64, 96."
        },
        "outlineColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Pointer outline colour (#rrggbb). The default #ffffff is the packaged cursor theme; any other pair makes the shell regenerate the theme grassfield-cursors-custom."
        },
        "fillColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Pointer fill colour (#rrggbb). The default #000000 is the packaged cursor theme."
        }
      }
    },
    "wallpaper": {
      "type": "object",
      "additionalProperties": false,
      "description": "Wallpaper (Settings > Wallpaper, ADR-0016). Invalid values read as the defaults.",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "builtin",
            "color",
            "file",
            "folder",
            "video",
            "online"
          ],
          "description": "builtin = the Grassfield artwork; color = a plain colour; file = one picture; folder = a carousel of the pictures of one folder; video = a looping video (played only while the pause rules allow it); online = the daily picture of wallpaper.online.provider (off by default: it contacts the network once a day, ADR-0016 step 2)."
        },
        "path": {
          "type": "string",
          "description": "Absolute path (no control characters, at most 4096 bytes) of the picture, folder or video; checked by the stores, not by the schema."
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "#rrggbb: the plain colour, and the backdrop of fit, centre and tile."
        },
        "fit": {
          "type": "string",
          "enum": [
            "fill",
            "fit",
            "stretch",
            "center",
            "tile"
          ],
          "description": "How a picture fills the screen (a video uses fill or fit only)."
        },
        "interval": {
          "type": "string",
          "enum": [
            "login",
            "5s",
            "1m",
            "5m",
            "15m",
            "30m",
            "1h",
            "1d"
          ],
          "description": "Folder only: when the picture changes (login = once, when the shell starts)."
        },
        "shuffle": {
          "type": "boolean",
          "description": "Folder only: random order, no repeat until every picture was shown; false = name order."
        },
        "videoOnBattery": {
          "type": "boolean",
          "description": "Video only: keep playing on battery power."
        },
        "online": {
          "type": "object",
          "additionalProperties": false,
          "description": "Online source only (wallpaper.source = online). Nothing is fetched while another source is chosen.",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "commons"
              ],
              "description": "commons = the Wikimedia Commons Picture of the Day (commons.wikimedia.org, thumb.wikimedia.org and upload.wikimedia.org, once a day)."
            }
          }
        },
        "outputs": {
          "type": "array",
          "description": "Per-display overrides (at most 16); omitted fields come from the top level. An override of a display that is not connected stays stored.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "display": {
                "type": "object",
                "additionalProperties": false,
                "description": "A display: model and serial when the serial is not empty, else the connector name.",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "serial": {
                    "type": "string"
                  }
                }
              },
              "source": {
                "type": "string",
                "enum": [
                  "builtin",
                  "color",
                  "file",
                  "folder",
                  "video",
                  "online"
                ]
              },
              "path": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "fit": {
                "type": "string",
                "enum": [
                  "fill",
                  "fit",
                  "stretch",
                  "center",
                  "tile"
                ]
              },
              "interval": {
                "type": "string",
                "enum": [
                  "login",
                  "5s",
                  "1m",
                  "5m",
                  "15m",
                  "30m",
                  "1h",
                  "1d"
                ]
              },
              "shuffle": {
                "type": "boolean"
              }
            },
            "required": [
              "display"
            ]
          }
        }
      }
    }
  }
}
