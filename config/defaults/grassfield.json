{
  "version": 1,
  "appearance": "dark",
  "material": {
    "transparency": 0.25,
    "profile": "balanced"
  },
  "accessibility": {
    "reduceTransparency": false,
    "reduceMotion": false
  },
  "dock": {
    "pinned": [
      "chromium",
      "foot",
      "org.grassfield.Settings"
    ],
    "magnification": 1.6,
    "magnificationEnabled": false,
    "autohide": false,
    "recent": [],
    "showRecents": true,
    "minimizeIntoApp": false,
    "minimizeEffect": "funnel"
  },
  "windows": {
    "titlebarDoubleClick": "zoom"
  },
  "notifications": {
    "dnd": false,
    "previews": "unlocked"
  },
  "lock": {
    "idleMinutes": 5
  },
  "hotCorners": {
    "topLeft": "none",
    "topRight": "none",
    "bottomLeft": "none",
    "bottomRight": "none"
  },
  "desktop": {
    "showIcons": true
  },
  "menubar": {
    "showBackground": false
  },
  "accent": {
    "color": "multicolor"
  },
  "icons": {
    "mode": "default",
    "tint": "accent",
    "folderColor": "theme"
  },
  "pointer": {
    "size": 24,
    "outlineColor": "#ffffff",
    "fillColor": "#000000"
  },
  "wallpaper": {
    "source": "builtin",
    "path": "",
    "color": "#000000",
    "fit": "fill",
    "interval": "1h",
    "shuffle": true,
    "videoOnBattery": false,
    "outputs": []
  }
}
