{
  "version": 1,
  "appearance": "dark",
  "material": {
    "transparency": 0.25,
    "profile": "balanced"
  },
  "accessibility": {
    "reduceTransparency": false,
    "reduceMotion": false,
    "increaseContrast": false,
    "textSize": 1,
    "zoom": false,
    "zoomLevel": 2
  },
  "dock": {
    "pinned": [
      "chromium",
      "foot",
      "org.grassfield.Settings"
    ],
    "size": 48,
    "position": "bottom",
    "magnification": 1.6,
    "autohide": false,
    "magnificationEnabled": false,
    "recent": [],
    "showRecents": true,
    "folders": [
      "~/Downloads"
    ],
    "stackOptions": {},
    "minimizeIntoApp": false,
    "animateOpening": true,
    "showIndicators": true,
    "minimizeEffect": "funnel"
  },
  "windows": {
    "titlebarDoubleClick": "zoom",
    "tilingEdges": true,
    "tilingMenuBar": true,
    "tilingMargins": true,
    "stages": false,
    "rebuildExtension": false
  },
  "notifications": {
    "dnd": false,
    "previews": "unlocked",
    "history": "week",
    "appStyles": [],
    "appPreviews": []
  },
  "lock": {
    "idleMinutes": 5
  },
  "hotCorners": {
    "topLeft": "none",
    "topRight": "none",
    "bottomLeft": "none",
    "bottomRight": "none"
  },
  "desktop": {
    "showIcons": true
  },
  "menubar": {
    "showBackground": false,
    "autoHide": "fullscreen",
    "showNowPlaying": true,
    "showSearch": true,
    "showWifi": true,
    "showSound": true,
    "showBattery": true,
    "showBatteryPercentage": true,
    "showFocus": true,
    "clockDate": "auto",
    "clockShowDayOfWeek": true,
    "clockHours": "auto",
    "clockShowAmPm": true,
    "clockFlashSeparators": false,
    "showTrayItems": true,
    "recentItems": 10,
    "clockShowSeconds": false
  },
  "accent": {
    "color": "multicolor"
  },
  "keyboard": {
    "shortcutStyle": "automatic"
  },
  "region": {
    "formats": "auto",
    "firstDayOfWeek": "auto"
  },
  "icons": {
    "mode": "default",
    "tint": "accent",
    "folderColor": "theme"
  },
  "pointer": {
    "size": 24,
    "outlineColor": "#ffffff",
    "fillColor": "#000000"
  },
  "search": {
    "clipboard": {
      "enabled": false,
      "retention": "8h",
      "keepOnDisk": false,
      "clearedAt": 0,
      "pinnedClearedAt": 0
    }
  },
  "wallpaper": {
    "source": "builtin",
    "path": "",
    "color": "#000000",
    "fit": "fill",
    "interval": "1h",
    "shuffle": true,
    "videoOnBattery": false,
    "online": {
      "provider": "commons"
    },
    "outputs": []
  }
}
