{
  "version": 1,
  "appearance": "dark",
  "material": {
    "transparency": 0.25,
    "profile": "balanced"
  },
  "accessibility": {
    "reduceTransparency": false,
    "reduceMotion": false
  },
  "dock": {
    "pinned": [
      "foot",
      "chromium",
      "org.gnome.Nautilus"
    ],
    "magnification": 1.6,
    "magnificationEnabled": false,
    "autohide": false,
    "recent": [],
    "showRecents": true,
    "minimizeIntoApp": false
  },
  "windows": {
    "titlebarDoubleClick": "zoom"
  },
  "notifications": {
    "dnd": false,
    "previews": "unlocked"
  },
  "lock": {
    "idleMinutes": 5
  },
  "hotCorners": {
    "topLeft": "none",
    "topRight": "none",
    "bottomLeft": "none",
    "bottomRight": "none"
  },
  "desktop": {
    "showIcons": true
  },
  "menubar": {
    "showBackground": false
  },
  "icons": {
    "mode": "default",
    "tint": "accent"
  }
}
