#!/usr/bin/python3 -I
# Terminal and developer apps follow the appearance (ADR-0045 OC-11; docs/specs/settings.md, Appearance > Terminal and
# Developer Apps).
#
#   grassfield-terminal-theme light|dark
#
# Applies the Omarchy theme chosen for that appearance (terminal.lightTheme / terminal.darkTheme of grassfield.json, as
# `omarchy-theme-list` names them) with Omarchy's own `omarchy-theme-set`, when terminal.matchAppearance is on. Omarchy's
# terminals (Alacritty, Ghostty, Kitty, foot), tmux, btop, Helix, Neovim, VS Code and the other tools its theme reaches then
# take it, in both sessions: Omarchy's theme is shared, so the Omarchy session gets the same theme and that theme's wallpaper.
# Run by the shell (shell/services/TerminalTheme.qml) at each change of the effective appearance and once at login; a person
# may run it too. One status line on stdout says what happened (the shell writes it to the journal).
#
# omarchy-theme-set is written for the Omarchy session. It runs here in an environment that keeps it out of the Grassfield
# session (every side effect and what happens to it: ADR-0045 OC-11 "Implementation note"):
#   - first in PATH, a private folder this helper makes at each run ($XDG_RUNTIME_DIR/grassfield/terminal-theme-bin, 0700,
#     refused when it is a link or not the user's) holding two stand-ins: `hyprctl`, which does nothing and fails, so the
#     chain's hyprctl calls, omarchy-restart-hyprctl's `hyprctl reload` (Omarchy 4.5.0: `hyprctl --instance 0 reload` outside
#     a session) and, in 4.5.0, omarchy-theme-set's read of animations:enabled (which then reads as off: no wallpaper intro),
#     never reach Grassfield's Hyprland (a reload resets what the shell set at run time); and `pkexec`, which fails as if absent (127), so the Chromium colour step
#     (omarchy-theme-set-browser-policy, which looks pkexec up in PATH when Omarchy's passwordless sudoers rule does not
#     apply) never puts an administrator password sheet on screen: it then leaves Chromium's colour as it was;
#   - no HYPRLAND_INSTANCE_SIGNATURE either (defence in depth: a hyprctl found another way reaches no compositor), and no
#     SUDO_ASKPASS (the chain's sudo is `sudo -n -l -l`, then `sudo` only after that listing showed a NOPASSWD grant; no -A
#     anywhere, and with stdin /dev/null sudo has no terminal to ask on);
#   - no DCONF_PROFILE: its gsettings writes (omarchy-theme-set-gnome: colour scheme, GTK theme, icon theme) go to the
#     user's dconf database through dconf's default profile, as in the Omarchy session; under Grassfield's profile
#     (ADR-0017, same writable database) the icon theme is locked and that write would fail. Grassfield's own look does not
#     come from those keys: GTK apps here read Grassfield's portal (ADR-0035 D-8) and the icon theme stays locked;
#   - Grassfield's stand-ins for Omarchy's shell (/usr/lib/grassfield/omarchy-shims: omarchy-shell, omarchy-restart-shell)
#     next in PATH, then Omarchy's bin directory (so that a login shell, which omarchy-theme-set starts for its app hooks,
#     never puts that directory before the stand-ins), then the rest of PATH (absolute entries only). Its calls to Omarchy's
#     shell (applyTheme, themeTransition, the theme picker's preload) are refused by the stand-in; nothing restarts or
#     signals grassfield-shell. Without the stand-ins nothing runs;
#   - Omarchy 4.5.0's omarchy-theme-set (docs/upstream/omarchy-4.5.0.lock; the helper follows 4.0.6 and 4.5.0) returns once what
#     is on screen has changed and runs the other retints (GTK, browser policy, editors) detached, in the same process group, so
#     the limits and the lock above cover them; they run directly on this PATH (no login shell: the stand-ins stay first). Its
#     calls to the OWE video-wallpaper client (`owe`) fail where owed does not run (the Grassfield session: the shell draws the
#     wallpaper, packaging/systemd/owed.service.d). Its mirror of the theme to herdr machines (`setsid`, so outside the group) is
#     Omarchy's own opt-in (the herdr-theme-sync toggle, off by default): it is not ours to stop;
#   - OMARCHY_PATH as the session gives it, else /usr/share/omarchy (as omarchy.lua finds Omarchy; omarchy-theme-set reads
#     its themes from there);
#   - stdin is /dev/null and it runs in a process session (and process group) of its own; its output goes to a private
#     temporary file (its last line is quoted when it fails). Past RUN_LIMIT its whole process group gets SIGTERM, then
#     SIGKILL after KILL_GRACE seconds; the lock is held until the group is gone, or for two graces at most when only
#     processes this user cannot signal are left (a root step of the chain).
# Nothing runs when the theme is already Omarchy's (`omarchy-theme-current`), when another run holds the lock
# ($XDG_RUNTIME_DIR/grassfield/terminal-theme.lock: this one waits for it, at most LOCK_WAIT seconds), or as root. Missing
# Omarchy commands: nothing runs, exit 0.
# Exit 0 applied or nothing to do; 1 refused or failed; 2 usage.
#
# Dev plumbing (ADR-0019, honoured only in a dev session: GRASSFIELD_DEV exactly "1" and GRASSFIELD_SESSION not "1"):
# GRASSFIELD_TERMINAL_THEME_SHIMS, the stand-ins' directory in place of /usr/lib/grassfield/omarchy-shims, and
# GRASSFIELD_TERMINAL_THEME_RUN_LIMIT, RUN_LIMIT in seconds (tests/shell/terminal_theme.sh). A dev session never reaches the
# owner's Omarchy: it runs only with the stand-in variable, an explicit absolute OMARCHY_PATH marked as a tree of fakes
# (FAKE_MARK at its root; neither the tree nor its bin, links resolved, inside /usr/share/omarchy), and omarchy-theme-set and
# omarchy-theme-current found, links resolved, directly in that tree's bin, outside the packaged Omarchy and the system
# directories; anything else is refused before any Omarchy command runs. Outside a dev session the stand-in variable is refused (a stray
# test setting). GRASSFIELD_CONFIG_HOME is honoured always, as by the shell (shell/lib/RunMode.js configDir).
# Standard library only.
import fcntl
import json
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time

SHIMS = "/usr/lib/grassfield/omarchy-shims"
# The stand-ins that must come first: the two commands of Omarchy's that reach its shell (packaging/shims).
STAND_INS = ("omarchy-shell", "omarchy-restart-shell")
# The run's own stand-ins, first in omarchy-theme-set's PATH (see the header), in $XDG_RUNTIME_DIR/grassfield/<STUB_DIR>.
STUB_DIR = "terminal-theme-bin"
STUBS = {
    "pkexec": "#!/bin/sh\n# grassfield-terminal-theme (ADR-0045 OC-11): an Omarchy theme change asks for no administrator password\n"
              "# in the Grassfield session.\necho \"pkexec: not available during a Grassfield terminal theme change\" >&2\nexit 127\n",
    "hyprctl": "#!/bin/sh\n# grassfield-terminal-theme (ADR-0045 OC-11): an Omarchy theme change never reloads Grassfield's Hyprland.\n"
               "exit 1\n",
}
# terminal.lightTheme / terminal.darkTheme in config/schema/grassfield.schema.json (pattern and defaults).
THEME = re.compile(r"[A-Za-z0-9][A-Za-z0-9 ._+-]{0,62}")
DEFAULTS = {"light": "Catppuccin Latte", "dark": "Tokyo Night"}
# Removed from omarchy-theme-set's environment (see the header).
UNSET = ("HYPRLAND_INSTANCE_SIGNATURE", "DCONF_PROFILE", "SUDO_ASKPASS")
LOCK_WAIT = 120
# omarchy-theme-set may install a VS Code extension from the network; past this (seconds) its process group is stopped.
RUN_LIMIT = 600
KILL_GRACE = 5
QUERY_LIMIT = 10
PACKAGED_OMARCHY = "/usr/share/omarchy"
STAND_IN_VAR = "GRASSFIELD_TERMINAL_THEME_SHIMS"


def say(line):
    try:
        print(line, flush=True)
    except OSError:
        pass  # the caller went away (a shell restart): the run itself is done


def dev_session():
    return os.environ.get("GRASSFIELD_DEV") == "1" and os.environ.get("GRASSFIELD_SESSION") != "1"


def config_dir():
    """shell/lib/RunMode.js configDir: GRASSFIELD_CONFIG_HOME, else $XDG_CONFIG_HOME/grassfield, else ~/.config/grassfield."""
    if os.environ.get("GRASSFIELD_CONFIG_HOME"):
        return os.environ["GRASSFIELD_CONFIG_HOME"]
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.environ.get("HOME", ""), ".config")
    return os.path.join(base, "grassfield")


def read_settings(path):
    """The parsed grassfield.json, {} when it is missing, unreadable, not JSON or not an object (every key at its default)."""
    try:
        with open(path, "rb") as f:
            data = json.loads(f.read(1 << 20))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def setting(data, path, default, valid):
    """A dotted key as the settings contract reads it (SettingsContract.read): the default when absent or invalid."""
    node = data
    for part in path.split("."):
        if not isinstance(node, dict) or part not in node:
            return default
        node = node[part]
    return node if valid(node) else default


def theme_key(name):
    """The directory name omarchy-theme-set makes of a theme name ("Tokyo Night" -> "tokyo-night")."""
    return re.sub(r"<[^>]+>", "", name).strip().lower().replace(" ", "-")


def omarchy_path():
    """Omarchy's tree, as config/hypr/grassfield/omarchy.lua finds it (omarchy-theme-set reads its themes from there)."""
    return os.environ.get("OMARCHY_PATH") or PACKAGED_OMARCHY


# The file that marks a tree of fakes (the tests' OMARCHY_PATH). An Omarchy checkout that a developer's OMARCHY_PATH names
# (omarchy-dev-link's) has none, so a dev session never takes it for one (counter-review of ADR-0045, LOW-3).
FAKE_MARK = "grassfield-fake-omarchy"
# Where real programs live: a dev session's theme commands are never there.
SYSTEM_DIRS = ("/usr/", "/bin/", "/sbin/", "/opt/")


def inside(path, root):
    return path == root or path.startswith(root.rstrip(os.sep) + os.sep)


def fake_tree():
    """A dev session's OMARCHY_PATH, when it names a tree of fakes: set explicitly, absolute, neither it nor its bin (links
    resolved) in the packaged Omarchy, and marked by FAKE_MARK at its root."""
    explicit = os.environ.get("OMARCHY_PATH", "")
    if not explicit.startswith("/"):
        return False
    packaged = os.path.realpath(PACKAGED_OMARCHY)
    tree = os.path.realpath(explicit)
    tree_bin = os.path.realpath(os.path.join(explicit, "bin"))
    return not inside(tree, packaged) and not inside(tree_bin, packaged) and os.path.isfile(os.path.join(tree, FAKE_MARK))


def fake_command(command):
    """In a dev session: the command, its links resolved, is a file directly in the fake tree's bin (resolved), never in the
    packaged Omarchy nor in a system directory. The stand-ins folder is not an alternative: the tests never need it, and a
    stand-ins variable pointing at Omarchy's own bin would otherwise let the real commands through."""
    real = os.path.realpath(command)
    tree_bin = os.path.realpath(os.path.join(omarchy_path(), "bin"))
    return (os.path.dirname(real) == tree_bin and not inside(real, os.path.realpath(PACKAGED_OMARCHY))
            and not real.startswith(SYSTEM_DIRS))


def clean_path(shims):
    omarchy_bin = os.path.join(omarchy_path(), "bin")
    parts = [shims]
    if os.path.isdir(omarchy_bin):
        parts.append(omarchy_bin)
    for entry in (os.environ.get("PATH") or "/usr/local/bin:/usr/bin").split(":"):
        if entry.startswith("/") and entry not in parts and entry != SHIMS:
            parts.append(entry)
    return ":".join(parts)


def theme_env(path):
    env = {k: v for k, v in os.environ.items() if k not in UNSET}
    env["PATH"] = path
    env["OMARCHY_PATH"] = omarchy_path()
    # Omarchy 4.5's omarchy-theme-set returns once the terminals changed and leaves the other apps' retints (GTK, editors, the
    # browser policy) running behind it when it has no terminal for stdin, as here; then they would outlive this run's lock and
    # its time limit. OMARCHY_THEME_WAIT=1 makes it finish them first, as 4.0.6 always did (4.0.6 ignores the variable).
    env["OMARCHY_THEME_WAIT"] = "1"
    # Omarchy 4.5's omarchy-theme-set also starts omarchy-theme-set-herdr-machines under setsid (a session of its own, so past this
    # run's process-group limit), which can SSH to the machines of `herdr machine list`, this one included, and run an
    # unsanitised `omarchy theme set` in the live Hyprland session. That script exits at once when OMARCHY_THEME_SYNC_FROM is
    # non-empty (it is how a mirrored change is kept from being sent on); nothing else reads the variable.
    env["OMARCHY_THEME_SYNC_FROM"] = "grassfield"
    return env


def lock(runtime):
    """The run lock's descriptor (held until exit), or None when another run kept it for LOCK_WAIT seconds."""
    folder = os.path.join(runtime, "grassfield")
    os.makedirs(folder, mode=0o700, exist_ok=True)
    fd = os.open(os.path.join(folder, "terminal-theme.lock"), os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    deadline = time.monotonic() + LOCK_WAIT
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.monotonic() >= deadline:
                os.close(fd)
                return None
            time.sleep(0.2)


def private_dir(st):
    """True for a real directory (not a link) of this user that only this user can enter."""
    return stat.S_ISDIR(st.st_mode) and st.st_uid == os.geteuid() and stat.S_IMODE(st.st_mode) & 0o077 == 0


def make_stubs(runtime):
    """The run's stand-ins (STUBS), written afresh into $XDG_RUNTIME_DIR/grassfield/STUB_DIR; its path, or None when that
    path is a link, not a directory, or not this user's own (then nothing runs)."""
    folder = os.path.join(runtime, "grassfield", STUB_DIR)
    try:
        st = os.lstat(folder)
    except FileNotFoundError:
        st = None
    if st is not None:
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
            return None
        shutil.rmtree(folder)
    os.mkdir(folder, 0o700)
    if not private_dir(os.lstat(folder)):
        return None
    for name, body in STUBS.items():
        fd = os.open(os.path.join(folder, name), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o700)
        with os.fdopen(fd, "w") as f:
            f.write(body)
    return folder


def current_theme(command, env):
    try:
        r = subprocess.run([command], stdin=subprocess.DEVNULL, capture_output=True, env=env, timeout=QUERY_LIMIT, check=False)
    except (OSError, subprocess.SubprocessError):
        return ""
    lines = r.stdout.decode("utf-8", "replace").strip().splitlines()
    return lines[0].strip() if r.returncode == 0 and lines else ""


def last_line(f):
    f.seek(0, os.SEEK_END)
    f.seek(max(0, f.tell() - 4096))
    lines = [l.strip() for l in f.read().decode("utf-8", "replace").splitlines() if l.strip()]
    line = re.sub(r"[\x00-\x1f\x7f]", " ", lines[-1]) if lines else "no output"
    return line[:200]


def group_alive(pgid):
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def stop_group(proc):
    """SIGTERM to omarchy-theme-set's whole process group (its session: start_new_session), SIGKILL to what is left after
    KILL_GRACE seconds; returns once the group is gone (a process that made a session of its own has left it), or after the
    two graces when what is left cannot be signalled by this user."""
    pgid = proc.pid
    for sig, wait in ((signal.SIGTERM, KILL_GRACE), (signal.SIGKILL, KILL_GRACE)):
        try:
            os.killpg(pgid, sig)
        except ProcessLookupError:
            pass
        except PermissionError:
            # Only processes this user cannot signal are left (a root step of the chain, sudo's): keep waiting for the
            # grace, the lock still held, rather than leave with a traceback (counter-review of ADR-0045, LOW-4).
            pass
        deadline = time.monotonic() + wait
        while time.monotonic() < deadline:
            proc.poll()  # reaps the leader, so that it no longer counts
            if not group_alive(pgid):
                return
            time.sleep(0.1)
    proc.poll()


def apply(command, theme, env, limit):
    """(exit code, last output line) of omarchy-theme-set <theme>."""
    with tempfile.TemporaryFile() as out:
        try:
            proc = subprocess.Popen([command, theme], stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, env=env,
                                    start_new_session=True)
        except OSError as e:
            return 127, str(e)
        try:
            code = proc.wait(timeout=limit)
        except subprocess.TimeoutExpired:
            stop_group(proc)
            return 124, "omarchy-theme-set did not finish within %d seconds" % limit
        return code, last_line(out)


def run_limit(dev):
    """RUN_LIMIT, or in a dev session GRASSFIELD_TERMINAL_THEME_RUN_LIMIT (whole seconds, 1 to RUN_LIMIT)."""
    value = os.environ.get("GRASSFIELD_TERMINAL_THEME_RUN_LIMIT", "") if dev else ""
    return int(value) if value.isdigit() and 1 <= int(value) <= RUN_LIMIT else RUN_LIMIT


def main(argv):
    if len(argv) != 2 or argv[1] not in DEFAULTS:
        print("usage: grassfield-terminal-theme light|dark", file=sys.stderr)
        return 2
    mode = argv[1]
    if os.geteuid() == 0:
        say("refused: run it as the desktop user, not as root")
        return 1
    shims = SHIMS
    dev = dev_session()
    if dev:
        shims = os.environ.get(STAND_IN_VAR, "")
        if not shims:
            say("refused: a dev session changes no Omarchy theme (GRASSFIELD_TERMINAL_THEME_SHIMS is the test stand-in)")
            return 1
        if not fake_tree():
            say("refused: a dev session needs OMARCHY_PATH set to a tree of fakes (marked " + FAKE_MARK + "), never the installed Omarchy")
            return 1
    elif STAND_IN_VAR in os.environ:
        say("refused: GRASSFIELD_TERMINAL_THEME_SHIMS is test plumbing, honoured only in a dev session")
        return 1

    data = read_settings(os.path.join(config_dir(), "grassfield.json"))
    if not setting(data, "terminal.matchAppearance", False, lambda v: isinstance(v, bool)):
        say("skipped: Match Appearance is off")
        return 0
    theme = setting(data, "terminal.%sTheme" % mode, DEFAULTS[mode], lambda v: isinstance(v, str) and THEME.fullmatch(v) is not None)

    if not all(os.path.isfile(os.path.join(shims, n)) and os.access(os.path.join(shims, n), os.X_OK) for n in STAND_INS):
        say("refused: Grassfield's stand-ins for Omarchy's shell are not installed in " + shims)
        return 1
    path = clean_path(shims)
    theme_set = shutil.which("omarchy-theme-set", path=path)
    theme_current = shutil.which("omarchy-theme-current", path=path)
    if not theme_set or not theme_current:
        say("skipped: Omarchy's theme commands are not installed")
        return 0
    if dev and not all(fake_command(c) for c in (theme_set, theme_current)):
        say("refused: in a dev session omarchy-theme-set and omarchy-theme-current must be the fakes of OMARCHY_PATH/bin")
        return 1
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not runtime.startswith("/") or not os.path.isdir(runtime):
        say("refused: XDG_RUNTIME_DIR is not set")
        return 1

    fd = lock(runtime)
    if fd is None:
        say("failed: another run did not end within %d seconds" % LOCK_WAIT)
        return 1
    stubs = make_stubs(runtime)
    if stubs is None:
        say("refused: %s is not a private folder of this user (a link, or another owner)"
            % os.path.join(runtime, "grassfield", STUB_DIR))
        return 1
    env = theme_env(stubs + ":" + path)
    current = current_theme(theme_current, env)
    if current and theme_key(current) == theme_key(theme):
        say("skipped: %s is already Omarchy's theme" % theme)
        return 0
    code, line = apply(theme_set, theme, env, run_limit(dev))
    os.close(fd)
    if code != 0:
        say("failed: %s (omarchy-theme-set exit %d)" % (line, code))
        return 1
    say("applied %s (%s)" % (theme, mode))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
