#!/bin/bash
# Lid and clamshell handling of the Grassfield session (docs/audits/final-1.0/02-omarchy-compatibility.md §5.3).
#
#   grassfield-lid closed      the lid was closed (Hyprland switch bind, config/hypr/grassfield/system.lua)
#   grassfield-lid opened      the lid was opened
#   grassfield-lid reconcile   a monitor was added or removed, or the session started
#
# macOS model: with the lid closed and an external display connected, the computer keeps running on that display (the
# laptop panel is switched off and its windows move to the external display); with the lid closed and no external display
# it sleeps, and the screen is locked first. logind decides about suspend (HandleLidSwitchDocked defaults to ignore, so a
# docked lid does not suspend). On every lid close this script asks the shell to lock with `lock lid`; the shell decides
# (shell/security/lock/Lock.qml lockOnLid, LockMachine.lidShouldLock: no lock while a physical external display is
# active, i.e. clamshell mode; it locks also when logind does not suspend, D-4). This script only turns the laptop panel
# off or on for clamshell mode. Nothing here suspends or unlocks.
#
# When the shell does not answer (stopped, crashed, restarting) and no external display is connected, the lock is not
# dropped: Grassfield's `omarchy-shell` stand-in starts grassfield-shell again and asks it to lock (follow-up N3; the
# lock stays grassfield-shell's WlSessionLock + PamContext, no other locker). That matters when logind does not suspend
# on the lid (HandleLidSwitch=ignore or lock): nothing else would lock then.
#
# Test hooks: GRASSFIELD_LID_PROC (default /proc/acpi/button/lid), GRASSFIELD_DRM (default /sys/class/drm),
# GRASSFIELD_LID_LOCK (the lock command), GRASSFIELD_LID_FALLBACK (the stand-in), XDG_RUNTIME_DIR (marker and lock file).

set -u

LID_PROC=${GRASSFIELD_LID_PROC:-/proc/acpi/button/lid}
DRM=${GRASSFIELD_DRM:-/sys/class/drm}
RUNTIME=${XDG_RUNTIME_DIR:-/tmp}
MARKER=$RUNTIME/grassfield-lid-internal-off
LOCKFILE=$RUNTIME/grassfield-lid.lock
LOCK_CMD=${GRASSFIELD_LID_LOCK:-qs ipc -p /usr/share/grassfield/shell call lock lid}
FALLBACK=${GRASSFIELD_LID_FALLBACK:-/usr/lib/grassfield/omarchy-shims/omarchy-shell}

# Ask the shell to lock (it decides about clamshell mode). Its answers: ok, already-locked, docked, refused: <why>.
lock_on_close() {
  local answer
  if answer=$($LOCK_CMD 2>/dev/null); then
    case $answer in
      ok | already-locked | docked | refused:*) return 0 ;;
    esac
  fi
  # No answer (or "Not ready to accept queries yet"): the shell is down or starting. Clamshell decides here instead.
  external_connected && return 0
  # In the background: the panel handling must not wait for a shell restart (the stand-in waits up to ~10 s).
  [[ -x $FALLBACK ]] && setsid -f "$FALLBACK" lock lock >/dev/null 2>&1 </dev/null
  return 0
}

lid_closed() {
  local state
  for state in "$LID_PROC"/*/state; do
    [[ -r $state ]] || continue
    [[ $(<"$state") == *closed* ]] && return 0
  done
  return 1
}

# A connector of a built-in panel is eDP-N, LVDS-N or DSI-N (Hyprland uses the DRM connector names).
internal_connector() {
  local dir name
  for dir in "$DRM"/card*-*; do
    name=${dir##*/}
    name=${name#card*-}
    [[ $name =~ ^(eDP|LVDS|DSI)-[0-9A-Za-z]+$ ]] && { printf '%s\n' "$name"; return 0; }
  done
  return 1
}

external_connected() {
  local status name
  for status in "$DRM"/card*-*/status; do
    [[ -e $status ]] || continue
    name=${status%/status}
    name=${name##*/}
    [[ $name =~ -(eDP|LVDS|DSI)-[^/]+$ ]] && continue
    [[ $(<"$status") == connected ]] && return 0
  done
  return 1
}

reconcile() {
  local internal
  (
    flock -n 9 || exit 0
    if lid_closed && external_connected && internal=$(internal_connector); then
      if [[ ! -e $MARKER ]]; then
        : >"$MARKER"
        hyprctl eval "hl.monitor({ output = \"$internal\", disabled = true })" >/dev/null 2>&1 || rm -f "$MARKER"
      fi
    elif [[ -e $MARKER ]]; then
      # Back to the user's own monitors.lua (scale, position): a reload applies it again.
      rm -f "$MARKER"
      hyprctl reload >/dev/null 2>&1 || true
    fi
  ) 9>"$LOCKFILE"
}

case ${1:-} in
  closed)
    # First, before logind may suspend: the shell locks unless an external display is active (clamshell: the computer
    # keeps running and stays unlocked, as on macOS). Sent on every close, whatever /proc says (a lid that only reports
    # through the input switch still locks).
    lock_on_close
    reconcile
    ;;
  opened | reconcile)
    reconcile
    ;;
  *)
    echo "usage: grassfield-lid closed|opened|reconcile" >&2
    exit 2
    ;;
esac
