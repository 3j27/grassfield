#!/usr/bin/python3 -I
"""End the Grassfield session the way macOS does (GF-025, owner decision 2026-10-23).

    grassfield-session-end logout|restart|shutdown [--force] [--timeout SECONDS]

Every open window is asked to close (xdg_toplevel.close, never a kill), so an application with unsaved work can show its
own "Save?" sheet and keep the window open. Only when every window has gone is the session ended. If windows are still
open after the timeout nothing is ended: a notice lists the applications and offers "<Action> Anyway" (macOS: "Shut Down
Anyway"). Unsaved work is never lost silently. Omarchy's equivalent (omarchy-system-logout) closes the windows, waits one
second and ends the session regardless; this one waits for the applications and lets them veto.

An unknown state is never "no windows": a failed `hyprctl -j clients` is retried until the deadline, and a window list that
stays unknown cancels the logout with a notice (the "Anyway" button is the user's decision, never the script's). Only one run
exists at a time (a second Log Out click while the first waits exits quietly: its close requests would answer an
application's "Save?" sheet with Cancel).

Runs in the Grassfield session, started by the shell (shell/services/Power.qml). Standard library only; the helpers it
runs (hyprctl, notify-send or gdbus, systemctl, uwsm) are found through PATH.
"""
import fcntl
import glob
import json
import math
import os
import re
import subprocess
import sys
import time

ACTIONS = {
    "logout": ("Log Out", "Log Out Anyway"),
    "restart": ("Restart", "Restart Anyway"),
    "shutdown": ("Shut Down", "Shut Down Anyway"),
}
ADDRESS = re.compile(r"^0x[0-9a-fA-F]+$")
POLL = 0.25
TIMED_OUT = 124  # returncode of a helper that did not answer in time
SETTLE_EMPTY = 2  # consecutive empty window lists before the windows count as gone
ASK_TIMEOUT = 295  # seconds a "<Action> Anyway" notice waits; it expires by itself a little after


def run(argv, **kw):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=kw.pop("timeout", 10), **kw)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, TIMED_OUT, "", "")
    except (OSError, subprocess.SubprocessError):
        return None


def bounded_seconds(text, default, lo=0.0, hi=600.0):
    """A finite number of seconds within [lo, hi]; anything else (nan, inf, text, out of range) is the default."""
    try:
        v = float(text)
    except (TypeError, ValueError):
        return default
    return v if math.isfinite(v) and lo <= v <= hi else default


def windows():
    """Open client windows as [(address, class, title)]; None when the compositor cannot be asked."""
    r = run(["hyprctl", "-j", "clients"])
    if r is None or r.returncode != 0:
        return None
    try:
        data = json.loads(r.stdout)
    except ValueError:
        return None
    # Anything but a list of objects is not an answer about windows ([1], "x", {}): unknown, never "no windows".
    if not isinstance(data, list) or not all(isinstance(c, dict) for c in data):
        return None
    return [(c.get("address", ""), c.get("class", "") or "", c.get("title", "") or "") for c in data if isinstance(c, dict)]


def close_windows(open_windows):
    for address, _cls, _title in open_windows:
        if ADDRESS.match(address):  # interpolated into a Lua expression below: nothing but a hex address passes
            run(["hyprctl", "dispatch", 'hl.dsp.window.close({ window = "address:%s" })' % address])


def app_names(open_windows):
    names = []
    for _address, cls, title in open_windows:
        name = cls or title or "an application"
        if name not in names:
            names.append(name)
    return names


def end_session(action):
    """The step that really ends the session."""
    if action == "logout":
        # uwsm stops the compositor unit and the session's services in order; the compositor's own exit is the fallback.
        r = run(["uwsm", "stop"])
        if r is None or r.returncode != 0:
            run(["hyprctl", "dispatch", "hl.dsp.exit()"])
        return
    state = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    # Omarchy keeps "reboot required" and "restart <service> required" markers; a restart or shutdown satisfies them.
    for marker in glob.glob(os.path.join(state, "omarchy", "re*-required")):
        try:
            os.remove(marker)
        except OSError:
            pass
    run(["systemctl", "reboot" if action == "restart" else "poweroff", "--no-wall"])


def notify_plain(title, body):
    """One notification without an answer, for when libnotify (notify-send, an optional dependency) is missing: the shell's
    own notification service is asked over the session bus with gdbus (glib2). True when it was delivered."""
    r = run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications", "--object-path",
             "/org/freedesktop/Notifications", "--method", "org.freedesktop.Notifications.Notify", "Grassfield", "0", "",
             title, body, "[]", "{'urgency': <byte 2>}", "0"])
    return r is not None and r.returncode == 0


def notify_blocked(action, names, unknown=False):
    """Show the notice and wait for "<Action> Anyway". Returns True when the user chose it. Without notify-send the notice
    is still shown (through notify_plain, without the button): nothing is ended then."""
    label, anyway = ACTIONS[action]
    title = "Can't %s now" % label.lower()
    if unknown:
        body = "The list of open windows could not be read, so the session was not ended. Your work may still be open."
    else:
        body = "These applications are still open and may be waiting for you to save your work: %s." % ", ".join(names[:5])
    # The notice expires after ASK_TIMEOUT s (-t, milliseconds), before this process stops waiting: no "Anyway" button is left
    # behind that does nothing. A helper that timed out anyway has already shown the notice: no second one.
    r = run(["notify-send", "-a", "Grassfield", "-u", "critical", "-t", str(ASK_TIMEOUT * 1000), "-w", "-A", "force=" + anyway,
             title, body], timeout=ASK_TIMEOUT + 5)
    if r is not None and r.returncode == TIMED_OUT:
        return False
    if r is None or r.returncode != 0:
        notify_plain(title, body)
        return False
    return r.stdout.strip() == "force"


def single_instance():
    """False when another run holds the lock (it keeps going). The lock lasts as long as this process."""
    base = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    try:
        fd = os.open(os.path.join(base, "grassfield-session-end.lock"), os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return False
    except OSError:
        return True  # no lock possible (no writable runtime directory): a lock is a courtesy, not a reason to stay logged in
    return True


def first_list(deadline):
    """The window list before anything is closed; None when it stayed unknown until the deadline."""
    while True:
        cur = windows()
        if cur is not None or time.monotonic() >= deadline:
            return cur
        time.sleep(POLL)


def settle(deadline):
    """(known, windows still open) at the deadline. A failed query is retried and is never read as "no windows": the state
    is known only when the compositor's last answer was a list, and the windows count as gone only after SETTLE_EMPTY empty
    lists in a row (an application may close its window and open its "Save changes?" sheet a moment later)."""
    last = []
    empty = 0
    while True:
        cur = windows()
        if cur is not None:
            last = cur
            empty = empty + 1 if not cur else 0
            if empty >= SETTLE_EMPTY:
                return True, []
        else:
            empty = 0
        if time.monotonic() >= deadline:
            return cur is not None, last
        time.sleep(POLL)


def main(argv):
    force = "--force" in argv
    timeout = bounded_seconds(os.environ.get("GRASSFIELD_SESSION_END_TIMEOUT"), 15.0)
    args = []
    rest = iter(argv[1:])
    for a in rest:
        if a == "--timeout":
            timeout = bounded_seconds(next(rest, None), timeout)
        elif not a.startswith("--"):
            args.append(a)
    if len(args) != 1 or args[0] not in ACTIONS:
        print("usage: grassfield-session-end logout|restart|shutdown [--force] [--timeout SECONDS]", file=sys.stderr)
        return 2
    action = args[0]
    if not single_instance():
        return 0

    if not force:
        first = first_list(time.monotonic() + timeout)
        if first is None:
            print("grassfield-session-end: cannot list windows, nothing is ended", file=sys.stderr)
            if not notify_blocked(action, [], unknown=True):
                return 3
        else:
            # Ask the windows that exist now, once. A window that appears later is the application's own "Save changes?"
            # sheet: closing it would answer Cancel for the user, so it is left alone and counted as "still open".
            close_windows(first)
            known, current = settle(time.monotonic() + timeout)
            if not known:
                print("grassfield-session-end: the window list stayed unknown, nothing is ended", file=sys.stderr)
                if not notify_blocked(action, app_names(current), unknown=True):
                    return 3
            elif current:
                if not notify_blocked(action, app_names(current)):
                    return 3
        # Chromium and friends finish writing; then one more look: a window that appeared during the grace (a late Save
        # sheet) or an answer that cannot be read stops the logout. macOS ends it only when every app has really quit.
        time.sleep(bounded_seconds(os.environ.get("GRASSFIELD_SESSION_END_GRACE"), 1.0, 0.0, 30.0))
        last = windows()
        if last is None or last:
            print("grassfield-session-end: windows are open after the grace, nothing is ended", file=sys.stderr)
            if not notify_blocked(action, app_names(last or []), unknown=last is None):
                return 3
    else:
        time.sleep(bounded_seconds(os.environ.get("GRASSFIELD_SESSION_END_GRACE"), 1.0, 0.0, 30.0))
    end_session(action)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
