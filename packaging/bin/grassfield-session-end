#!/usr/bin/python3 -I
"""End the Grassfield session the way macOS does (GF-025, owner decision 2026-10-23).

    grassfield-session-end logout|restart|shutdown [--force] [--timeout SECONDS]

Every open window is asked to close (xdg_toplevel.close, never a kill), so an application with unsaved work can show its
own "Save?" sheet and keep the window open. Only when every window has gone is the session ended. If windows are still
open after the timeout nothing is ended: a notice lists the applications and offers "<Action> Anyway" (macOS: "Shut Down
Anyway"). Unsaved work is never lost silently. Omarchy's equivalent (omarchy-system-logout) closes the windows, waits one
second and ends the session regardless; this one waits for the applications and lets them veto.

Once the windows have gone (or the user chose "Anyway"), the shell's exit cover fades the whole screen to the ground and the
session ends under it (ADR-0040 ID-10): the cover is asked for over the shell's IPC and waited for, both within EXIT_WAIT;
a shell that does not answer costs nothing but the fade. When the session then cannot be ended the cover is lifted and the
exit status is 4, so the desktop never stays hidden behind it.

An unknown state is never "no windows": a failed `hyprctl -j clients` is retried until the deadline, and a window list that
stays unknown cancels the logout with a notice (the "Anyway" button is the user's decision, never the script's). Only one run
exists at a time (a second Log Out click while the first waits exits quietly: its close requests would answer an
application's "Save?" sheet with Cancel).

Runs in the Grassfield session, started by the shell (shell/services/Power.qml). Standard library only; the helpers it
runs (hyprctl, notify-send or gdbus, systemctl, uwsm, qs) are found through PATH.
"""
import fcntl
import glob
import json
import math
import os
import re
import select
import subprocess
import sys
import time

ACTIONS = {  # (button of the "Anyway" notice, title of that notice), both through tr()
    "logout": ("Log Out Anyway", "Can't log out now"),
    "restart": ("Restart Anyway", "Can't restart now"),
    "shutdown": ("Shut Down Anyway", "Can't shut down now"),
}
# Strings: English is the source, CATALOG the French translation (gate I1: scripts/dev/check-i18n.py). The helpers cannot load
# Qt's .qm catalogs (standard library only). Language: GRASSFIELD_LANG, else LC_ALL, LC_MESSAGES, LANG as the shell does.
UNKNOWN_BODY = "The list of open windows could not be read, so the session was not ended. Your work may still be open."
OPEN_BODY = "These applications are still open and may be waiting for you to save your work: %s."
CATALOG = {
    "fr": {
        "Log Out Anyway": "Fermer la session malgré tout",
        "Restart Anyway": "Redémarrer malgré tout",
        "Shut Down Anyway": "Éteindre malgré tout",
        "Can't log out now": "Impossible de fermer la session maintenant",
        "Can't restart now": "Impossible de redémarrer maintenant",
        "Can't shut down now": "Impossible d’éteindre maintenant",
        UNKNOWN_BODY: "La liste des fenêtres ouvertes n’a pas pu être lue, la session n’a donc pas été fermée. "
                      "Votre travail est peut-être encore ouvert.",
        OPEN_BODY: "Ces apps sont encore ouvertes et attendent peut-être que vous enregistriez votre travail : %s.",
    },
}


def tr(text):
    lang = next((os.environ[v] for v in ("GRASSFIELD_LANG", "LC_ALL", "LC_MESSAGES", "LANG") if os.environ.get(v)), "")
    return CATALOG.get(lang.partition("_")[0].partition(".")[0].partition("@")[0], {}).get(text, text)
# Checked with fullmatch: `$` also matches before a trailing newline, so an address "0x1\n" passed into the Lua expression
# below (tests/fuzz/fuzz_helpers.py session-end, seed 1, iteration 19129 of 20 000).
ADDRESS = re.compile(r"0x[0-9a-fA-F]{1,16}")
POLL = 0.25
TIMED_OUT = 124  # returncode of a helper that did not answer in time
SETTLE_EMPTY = 2  # consecutive empty window lists before the windows count as gone
ASK_TIMEOUT = 295  # seconds a "<Action> Anyway" notice waits before it is closed (GRASSFIELD_SESSION_END_ASK_TIMEOUT, tests)
# The shell's exit cover (ADR-0040 ID-10), its instance called by its path as grassfield-lid and hyprland-dialog call it; whole
# command lines, so that tests/security/ipc_inventory.sh finds this helper as the caller of `session cover` and `session lift`.
COVER = "qs ipc -p /usr/share/grassfield/shell call session cover"  # i18n-ignore (a command line)
LIFT = "qs ipc -p /usr/share/grassfield/shell call session lift"  # i18n-ignore (a command line)
EXIT_WAIT = 1.0  # session.exitWaitMs (ui/tokens/tokens.json; tests/shell/session_end.sh holds them equal): the exit cover's bound


def run(argv, **kw):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=kw.pop("timeout", 10), **kw)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, TIMED_OUT, "", "")
    except (OSError, subprocess.SubprocessError):
        return None


def bounded_seconds(text, default, lo=0.0, hi=600.0):
    """A finite number of seconds within [lo, hi]; anything else (nan, inf, text, out of range) is the default."""
    try:
        v = float(text)
    except (TypeError, ValueError):
        return default
    return v if math.isfinite(v) and lo <= v <= hi else default


def windows():
    """Open client windows as [(address, class, title)]; None when the compositor cannot be asked."""
    r = run(["hyprctl", "-j", "clients"])
    if r is None or r.returncode != 0:
        return None
    try:
        data = json.loads(r.stdout)
    except ValueError:
        return None
    # Anything but a list of objects is not an answer about windows ([1], "x", {}): unknown, never "no windows".
    if not isinstance(data, list) or not all(isinstance(c, dict) for c in data):
        return None
    out = []
    for c in data:
        address, cls, title = c.get("address", ""), c.get("class", ""), c.get("title", "")
        # A window whose address, class or title is not text is not a window we can name or close: the list is unknown
        # (cancel with a notice), never a crash and never "no windows".
        if not isinstance(address, str) or not isinstance(cls, (str, type(None))) or not isinstance(title, (str, type(None))):
            return None
        out.append((address, cls or "", title or ""))
    return out


def close_windows(open_windows):
    for address, _cls, _title in open_windows:
        if ADDRESS.fullmatch(address):  # interpolated into a Lua expression below: nothing but a hex address passes
            run(["hyprctl", "dispatch", 'hl.dsp.window.close({ window = "address:%s" })' % address])


def app_names(open_windows):
    names = []
    for _address, cls, title in open_windows:
        name = cls or title or "an application"
        if name not in names:
            names.append(name)
    return names


def shell_call(command, timeout):
    """COVER or LIFT on the shell's instance; its answer, None when it did not answer. Quickshell's option variables are
    cleared as every IPC caller of the session does (a stray QS_MANIFEST made the IPC call exit 108)."""
    env = {k: v for k, v in os.environ.items() if k not in ("QS_CONFIG_PATH", "QS_CONFIG_NAME", "QS_MANIFEST")}
    r = run(command.split(), timeout=timeout, env=env)
    if r is None or r.returncode != 0:
        return None
    return r.stdout.strip()


def cover():
    """ADR-0040 ID-10: the shell's exit cover, one fade of the whole screen to the ground, asked for and waited for within
    EXIT_WAIT. True when the shell put it up (it is lifted again if the session does not end)."""
    deadline = time.monotonic() + EXIT_WAIT
    answer = shell_call(COVER, EXIT_WAIT)
    if answer is None:
        return False
    fade = bounded_seconds(answer, 0.0, 0.0, EXIT_WAIT * 1000) / 1000  # the fade's milliseconds; anything else waits nothing
    time.sleep(max(0.0, min(fade, deadline - time.monotonic())))
    return True


def end_session(action):
    """The step that really ends the session. False when it could not be started (the command failed or did not answer)."""
    if action == "logout":
        # uwsm stops the compositor unit and the session's services in order; the compositor's own exit is the fallback.
        r = run(["uwsm", "stop"])
        if r is None or r.returncode != 0:
            r = run(["hyprctl", "dispatch", "hl.dsp.exit()"])
        return r is not None and r.returncode == 0
    state = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    # Omarchy keeps "reboot required" and "restart <service> required" markers; a restart or shutdown satisfies them.
    for marker in glob.glob(os.path.join(state, "omarchy", "re*-required")):
        try:
            os.remove(marker)
        except OSError:
            pass
    r = run(["systemctl", "reboot" if action == "restart" else "poweroff", "--no-wall"])
    return r is not None and r.returncode == 0


def finish(action):
    """The exit cover, then the end of the session; the cover is lifted when the session cannot be ended (exit 4)."""
    covered = cover()
    if end_session(action):
        return 0
    print("grassfield-session-end: the session could not be ended (%s)" % action, file=sys.stderr)
    if covered:
        shell_call(LIFT, EXIT_WAIT)
    return 4


def notify_plain(title, body):
    """One notification without an answer, for when libnotify (notify-send, an optional dependency) is missing: the shell's
    own notification service is asked over the session bus with gdbus (glib2). True when it was delivered."""
    r = run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications", "--object-path",
             "/org/freedesktop/Notifications", "--method", "org.freedesktop.Notifications.Notify", "Grassfield", "0", "",
             title, body, "[]", "{'urgency': <byte 2>}", "0"])
    return r is not None and r.returncode == 0


def close_notice(notice_id):
    """Close a notification by id (org.freedesktop.Notifications.CloseNotification): the "Anyway" button must not outlive the
    decision. Our notification server never expires critical notices, so this is done explicitly."""
    if notice_id:
        run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications", "--object-path",
             "/org/freedesktop/Notifications", "--method", "org.freedesktop.Notifications.CloseNotification", str(notice_id)])


def ask(title, body, anyway, timeout):
    """Show a critical notice with one "<Action> Anyway" button and wait up to `timeout` seconds. Returns "force" when the user
    pressed it, "" for dismissed or timed out, None when notify-send is unusable. The notice is closed by id on every way out."""
    try:
        proc = subprocess.Popen(["notify-send", "-a", "Grassfield", "-u", "critical", "-t", "0", "-p", "-w", "-A", "force=" + anyway,
                                 title, body], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    except OSError:
        return None
    notice_id = None
    lines = []
    deadline = time.monotonic() + timeout
    try:
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                break
            ready, _, _ = select.select([proc.stdout], [], [], min(left, 1.0))
            if ready:
                line = proc.stdout.readline()
                if line == "":
                    break
                lines.append(line.strip())
                if notice_id is None and lines[0].isdigit():
                    notice_id = int(lines[0])
            elif proc.poll() is not None:
                break
    finally:
        if proc.poll() is None:
            proc.kill()
        try:
            proc.wait(timeout=5)
        except subprocess.SubprocessError:
            pass
        close_notice(notice_id)
    if proc.returncode not in (0, None, -9) and not lines:
        return None
    answer = [l for l in lines if l and not l.isdigit()]
    return "force" if "force" in answer else ""


def notify_blocked(action, names, unknown=False):
    """Show the notice and wait for "<Action> Anyway". Returns True when the user chose it. Without notify-send the notice
    is still shown (through notify_plain, without the button): nothing is ended then."""
    anyway, title = ACTIONS[action]
    anyway, title = tr(anyway), tr(title)
    if unknown:
        body = tr(UNKNOWN_BODY)
    else:
        body = tr(OPEN_BODY) % ", ".join(names[:5])
    answer = ask(title, body, anyway, bounded_seconds(os.environ.get("GRASSFIELD_SESSION_END_ASK_TIMEOUT"), float(ASK_TIMEOUT), 1.0, 3600.0))
    if answer is None:
        notify_plain(title, body)
        return False
    return answer == "force"


def single_instance():
    """False when another run holds the lock (it keeps going). The lock lasts as long as this process."""
    base = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    try:
        fd = os.open(os.path.join(base, "grassfield-session-end.lock"), os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return False
    except OSError:
        return True  # no lock possible (no writable runtime directory): a lock is a courtesy, not a reason to stay logged in
    return True


def first_list(deadline):
    """The window list before anything is closed; None when it stayed unknown until the deadline."""
    while True:
        cur = windows()
        if cur is not None or time.monotonic() >= deadline:
            return cur
        time.sleep(POLL)


def settle(deadline):
    """(known, windows still open) at the deadline. A failed query is retried and is never read as "no windows": the state
    is known only when the compositor's last answer was a list, and the windows count as gone only after SETTLE_EMPTY empty
    lists in a row (an application may close its window and open its "Save changes?" sheet a moment later)."""
    last = []
    empty = 0
    while True:
        cur = windows()
        if cur is not None:
            last = cur
            empty = empty + 1 if not cur else 0
            if empty >= SETTLE_EMPTY:
                return True, []
        else:
            empty = 0
        # At the deadline an empty list still needs its confirming second one (SETTLE_EMPTY in a row, every path).
        if time.monotonic() >= deadline and not (cur is not None and not cur):
            return cur is not None, last
        time.sleep(POLL)


def main(argv):
    force = "--force" in argv
    timeout = bounded_seconds(os.environ.get("GRASSFIELD_SESSION_END_TIMEOUT"), 15.0)
    args = []
    rest = iter(argv[1:])
    for a in rest:
        if a == "--timeout":
            timeout = bounded_seconds(next(rest, None), timeout)
        elif not a.startswith("--"):
            args.append(a)
    if len(args) != 1 or args[0] not in ACTIONS:
        print("usage: grassfield-session-end logout|restart|shutdown [--force] [--timeout SECONDS]", file=sys.stderr)
        return 2
    action = args[0]
    if not single_instance():
        return 0

    forced = force  # the user's own "Anyway" (or --force) is final: nothing is looked at or asked again
    if not force:
        first = first_list(time.monotonic() + timeout)
        if first is None:
            print("grassfield-session-end: cannot list windows, nothing is ended", file=sys.stderr)
            if not notify_blocked(action, [], unknown=True):
                return 3
            forced = True
        else:
            # Ask the windows that exist now, once. A window that appears later is the application's own "Save changes?"
            # sheet: closing it would answer Cancel for the user, so it is left alone and counted as "still open".
            close_windows(first)
            known, current = settle(time.monotonic() + timeout)
            if not known:
                print("grassfield-session-end: the window list stayed unknown, nothing is ended", file=sys.stderr)
                if not notify_blocked(action, app_names(current), unknown=True):
                    return 3
                forced = True
            elif current:
                if not notify_blocked(action, app_names(current)):
                    return 3
                forced = True
        # Chromium and friends finish writing; then one more look: a window that appeared during the grace (a late Save
        # sheet) or an answer that cannot be read stops the logout. macOS ends it only when every app has really quit.
        time.sleep(bounded_seconds(os.environ.get("GRASSFIELD_SESSION_END_GRACE"), 1.0, 0.0, 30.0))
        if not forced:
            last = windows()
            if last is None or last:
                print("grassfield-session-end: windows are open after the grace, nothing is ended", file=sys.stderr)
                if not notify_blocked(action, app_names(last or []), unknown=last is None):
                    return 3
    else:
        time.sleep(bounded_seconds(os.environ.get("GRASSFIELD_SESSION_END_GRACE"), 1.0, 0.0, 30.0))
    return finish(action)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
