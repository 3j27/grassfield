#!/bin/sh
# grassfield-security-status: what the Grassfield security process answers (ADR-0041 step 1, S1). Read-only, needs no
# privileges; the measurements of S1 and the owner's checks run it.
#   grassfield-security-status        prints one line: state=<what the process hosts> heartbeat=<state and sequence>
#                                     unit=<ActiveState SubState MainPID MemoryCurrent of grassfield-security.service>
# Exit 0 when the process answers, 1 when it does not ("not running"). It calls the security instance's IPC target by its
# path (the unit's ExecStart path), with Quickshell's option variables cleared as every `qs ipc` caller of the session
# does (a stray QS_MANIFEST made `qs ipc -p` exit 108: the re-review of bf9e280).
unset QS_CONFIG_PATH QS_CONFIG_NAME QS_MANIFEST
path=/usr/share/grassfield/shell/security.qml
state=$(timeout -k 0.2 2 qs ipc -p "$path" call security state 2>/dev/null) || { echo "security: not running (no answer from $path)" >&2; exit 1; }
beat=$(timeout -k 0.2 2 qs ipc -p "$path" call security heartbeat 2>/dev/null) || beat="?"
unit=$(systemctl --user show -p ActiveState -p SubState -p MainPID -p MemoryCurrent --value grassfield-security.service 2>/dev/null | tr '\n' ' ')
printf 'state=%s heartbeat="%s" unit="%s"\n' "$state" "$beat" "${unit% }"
exit 0
