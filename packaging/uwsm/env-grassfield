# Grassfield session environment (ADR-0017). Installed as /usr/share/uwsm/env-grassfield.
# uwsm sources uwsm/env-<desktop> from $XDG_CONFIG_HOME, $XDG_CONFIG_DIRS and $XDG_DATA_DIRS for each lowercased item of
# XDG_CURRENT_DESKTOP ("Hyprland:Grassfield" for packaging/wayland-sessions/grassfield.desktop), exports the difference to
# the systemd user manager and the D-Bus activation environment, and unsets it again at the end of the session.
# The Omarchy session never sources this file: its XDG_CURRENT_DESKTOP has no Grassfield item.
# Note: "Hyprland:Grassfield" is the value only while uwsm prepares the session. Omarchy's envs.lua (loaded by
# config/hypr/grassfield/omarchy.lua) sets XDG_CURRENT_DESKTOP=Hyprland in the compositor, and `uwsm finalize` exports that
# value, so the running session has XDG_CURRENT_DESKTOP=Hyprland on purpose (screen sharing, portals and Electron apps
# recognise exactly that). XDG_SESSION_DESKTOP=Grassfield identifies the session; applications cannot use OnlyShowIn=Grassfield.
# POSIX sh only (uwsm sources it with its own shell).

# GF-032: commands that would start Omarchy's own shell next to grassfield-shell (the restart step of an Omarchy update,
# theme and font changes) are shadowed by no-op stand-ins; this directory comes first in PATH for everything the systemd
# user manager starts (Dock, D-Bus activation). The compositor's own children get the same PATH from omarchy.lua.
if [ -x /usr/lib/grassfield/omarchy-shims/omarchy-restart-shell ]; then
    export PATH="/usr/lib/grassfield/omarchy-shims:$PATH"
fi

# Qt (the shell, Grassfield Settings/Files/Preview, every other Qt app): QIconLoader reads this variable before the
# platform theme's hint, so it wins over QT_QPA_PLATFORMTHEME=gtk3 from Omarchy's environment. An empty value is ignored.
export QT_QPA_SYSTEM_ICON_THEME=grassfield-icons

# GTK, Electron, Chromium, Firefox and (through xdg-desktop-portal-gtk) Flatpak read the icon theme from dconf. This
# session profile is the normal user database plus a read-only Grassfield database that holds the locked
# icon-theme='grassfield-icons' and the unlocked font defaults of ADR-0003 (10-fonts.conf); nothing is written to the shared database (spike I0: tests/shell/dconf_profile.sh).
# Only when the profile and its database are readable: a profile dconf cannot open gives the "null configuration"
# (every GTK setting at its default), so a half-installed package must not set it.
if [ -r /usr/share/grassfield/dconf/profile ] && [ -r /usr/share/grassfield/dconf/grassfield.db ]; then
    export DCONF_PROFILE=/usr/share/grassfield/dconf/profile
    # GF-117: an administrator's database (/etc/dconf/db/local) wins over Grassfield's defaults when it exists. The profile
    # that lists it is used only then, because dconf warns in every client about a listed database that is missing.
    if [ -r /etc/dconf/db/local ] && [ -r /usr/share/grassfield/dconf/profile-local ]; then
        export DCONF_PROFILE=/usr/share/grassfield/dconf/profile-local
    fi
fi

# Fonts (ADR-0003): a session fontconfig that includes the system /etc/fonts/fonts.conf (so the user's own
# fontconfig still loads), and prefers Inter, inserted in place, for sans-serif, system-ui and the macOS web font names, and sets grayscale
# antialiasing with slight hinting. Read by every fontconfig client (GTK, Qt, Chromium, Electron, Firefox).
# FONTCONFIG_FILE replaces the system file, so it is exported only when the file is readable.
if [ -r /usr/share/grassfield/fontconfig/fonts.conf ]; then
    export FONTCONFIG_FILE=/usr/share/grassfield/fontconfig/fonts.conf
fi

# Secret Service (ADR-0035 D-12, owner decision Q17-b): nobody holds org.freedesktop.secrets at login, and KWallet's ksecretd
# takes it whenever a KWallet client starts before gnome-keyring (Files on an sftp: or smb: location is enough); Chromium's
# saved passwords and every libsecret client then go to KWallet. The session's kwalletrc turns that off; it is read through
# this directory, first in XDG_CONFIG_DIRS and below the user's own ~/.config (the user's kwalletrc wins). /etc/xdg stays in
# the list. Only when the file is readable, and only once.
if [ -r /usr/share/grassfield/xdg-config/kwalletrc ]; then
    case ":${XDG_CONFIG_DIRS:-}:" in
        *:/usr/share/grassfield/xdg-config:*) ;;
        *) export XDG_CONFIG_DIRS="/usr/share/grassfield/xdg-config:${XDG_CONFIG_DIRS:-/etc/xdg}" ;;
    esac
fi

# Text antialiasing of QtQuick (the shell and every Qt Quick app): distance-field text, the default renderer, picks its mode in
# QSGDefaultContext (qtdeclarative 6.11, qsgdefaultcontext.cpp) as HighQualitySubPixelAntialiasing and never reads fontconfig
# or the GTK setting, which gave orange/blue fringes (visual audit 2026-10-25, section 2). QSG_DISTANCEFIELD_ANTIALIASING=gray
# selects grayscale, as ADR-0003 and macOS have it. Qt Widgets and native-rendered text follow FC_RGBA (fonts.conf: none,
# above) and GTK follows font-antialiasing='grayscale' (dconf, above), so they were already gray.
export QSG_DISTANCEFIELD_ANTIALIASING=gray
