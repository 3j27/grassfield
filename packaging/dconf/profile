# Grassfield session dconf profile (ADR-0017). The first line is the only writable database.
# system-db:local (GF-117) is an administrator's /etc/dconf/db/local (MDM-style). In dconf the first database wins: its
# defaults beat Grassfield's own defaults (the line below it) but not the user's own settings (the line above it). Only the
# locks an administrator sets there bind the user. dconf skips it silently when it does not exist.
user-db:user
system-db:local
file-db:/usr/share/grassfield/dconf/grassfield.db
