# Grassfield session dconf profile (ADR-0017). The first line is the only writable database.
# The user's own settings win; Grassfield's read-only defaults come last. This is the profile of a machine without an
# administrator database; with one, env-grassfield picks profile-local instead (GF-117).
user-db:user
file-db:/usr/share/grassfield/dconf/grassfield.db
