# Grassfield (ADR-0009, amendment 2026-10-23): removing the extension also removes the build made on this machine
# (/var/lib/grassfield/compositor), which no package owns.
[Trigger]
Operation = Remove
Type = Package
Target = grassfield-compositor

[Action]
Description = Removing the Grassfield compositor extension built on this machine...
When = PreTransaction
Exec = /usr/lib/grassfield/grassfield-compositor-rebuild --clean
