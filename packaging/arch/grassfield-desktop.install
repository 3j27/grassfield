# pacman scriptlet of grassfield-desktop (runs as root, only prints): the login-path check of GF-015.
# It reads files and never changes anything; its lines are the owner's feedback that the login screen reaches Grassfield.

post_install() {
  echo "grassfield: checking the login path (also: /usr/lib/grassfield/grassfield-login-check)"
  /usr/lib/grassfield/grassfield-login-check 2>&1 | sed 's/^/grassfield: /' || true
  echo "grassfield: restart the computer once: SDDM reads its configuration only when it starts, so until then the login screen still starts your previous session. After that it starts Grassfield; Omarchy stays one command away: grassfield-login set omarchy"
}

post_upgrade() {
  # GF-115: since this version the shell is started from /usr/share/grassfield/shell by path. A shell still running from the
  # earlier unit was started by name (through /etc/xdg/quickshell) and Quickshell matches instances by the path they were
  # started with, so the key bindings, lid handler and sleep lock cannot reach it until it restarts. Restarting is safe while
  # locked (the compositor keeps the lock, ADR-0010). Said only when upgrading from a version older than the first one that
  # loads by path (pacman passes the new version as $1 and the old one as $2); later upgrades stay quiet.
  # FIRST_PATH_LOADED is the first version after the last release that started the shell by name (main was 0.4.0-12 when this
  # was written, so any release that carries this scriptlet, 1.0.0rc1-1 included, is above it and no later one repeats the note).
  FIRST_PATH_LOADED=0.4.0-13
  if [ -n "${2:-}" ] && [ "$(vercmp "$2" "$FIRST_PATH_LOADED" 2>/dev/null || echo 0)" -lt 0 ]; then
    echo "grassfield: after this upgrade restart the shell once: systemctl --user restart grassfield-shell (or log out and in)"
  fi
  /usr/lib/grassfield/grassfield-login-check 2>&1 | sed 's/^/grassfield: /' || true
}
