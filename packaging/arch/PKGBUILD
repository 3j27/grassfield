# Maintainer: Grassfield project
# Local package build from this repository. grassfield-desktop and grassfield-compositor need no download; the optional
# grassfield-whitesur-icons fetches ONE pinned upstream commit (WhiteSur icon theme, GPL-3.0, ADR-0017):
#   cd packaging/arch && makepkg -si        (owner runs it; installs with sudo through pacman)
# Remove: sudo pacman -Rns grassfield-desktop grassfield-compositor grassfield-whitesur-icons
# Never constrain the hyprland version here (ADR-0009, master-prompt §5.6).

pkgbase=grassfield
# grassfield-whitesur-icons is WITHHELD (integrator decision 2026-10-21, docs/STATE.md): four counter-reviews each found
# more Apple app-icon artwork left after filtering, so it is not built unless GRASSFIELD_WITH_WHITESUR=1 is set for a
# review build. Without it the grassfield-icons wrapper resolves app icons through Breeze and Adwaita.
_with_whitesur=${GRASSFIELD_WITH_WHITESUR:-0}
pkgname=(grassfield-desktop grassfield-compositor)
[[ $_with_whitesur == 1 ]] && pkgname+=(grassfield-whitesur-icons)
pkgver=0.4.0
pkgrel=6
pkgdesc="Grassfield Desktop: a polished desktop session for Omarchy (built for Omarchy, based on Arch Linux)"
arch=(x86_64)
url="https://grassfield.invalid"
# Grassfield's own code is MIT (ADR-0005, accepted by the owner 2026-10-18; root LICENSE, installed by both packages).
# Third-party notices: THIRD_PARTY.md, installed under /usr/share/licenses/<package>/.
license=(MIT)
makedepends=(cmake ninja pkgconf hyprland gtest lua extra-cmake-modules qt6-declarative qt6-tools hyprcursor librsvg python dconf gtk3 git)
options=(!debug)
# WhiteSur icon theme (third party, GPL-3.0). Same pin and reviewed install.sh as scripts/dev/whitesur.sh: update both
# together, after reading the new install.sh in full. Integrity: the commit id (makepkg checks it out by id), the
# SHA-256 of the `git archive` of that commit below (pacman 7.1 calc_checksum_git), and the SHA-256 of install.sh that
# build() verifies before running it. The Apple-artwork guard (whitesur-guard.sh, whitesur-detect.py, ADR-0017) must be
# re-derived on a pin change: whitesur-guard.sh list <checkout> > whitesur-apple-logos.txt after viewing the logos, and the
# whole new tree reviewed on contact sheets for Apple trademark artwork (whitesur-blocklist.txt).
_whitesur_commit=73d8040da51a9ed74e47c7366e7e9ff437601a5c
_whitesur_install_sha256=295fdee31bead5e6b184b82a1b6341e6096ab3ea59ed5f30416f6c707cc945d1
source=()
sha256sums=()
if [[ $_with_whitesur == 1 ]]; then
  source+=("whitesur-icon-theme::git+https://github.com/vinceliuice/WhiteSur-icon-theme.git#commit=${_whitesur_commit}")
  sha256sums+=('e4c97aa6258e86360a5387e71a42d61c39389a56de6e67c0dfedf8213fdf639a')
fi

_root() { realpath "$startdir/../.."; }

build() {
  cmake -S "$(_root)/compositor" -B "$srcdir/compositor-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DGRASSFIELD_BUILD_TESTS=ON
  cmake --build "$srcdir/compositor-build"
  # Grassfield.I18n QML module (Translator singleton) and the compiled catalogs (translations/*.ts).
  cmake -S "$(_root)/ui/i18n" -B "$srcdir/i18n-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/i18n-build"
  cmake -S "$(_root)/apps/settings" -B "$srcdir/settings-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/settings-build"
  cmake -S "$(_root)/apps/files" -B "$srcdir/files-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/files-build"
  cmake -S "$(_root)/apps/preview" -B "$srcdir/preview-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/preview-build"
  # grassfield-menu-bridge (ADR-0008): global menus, systemd user unit, D-Bus diagnostics XML.
  cmake -S "$(_root)/bridges/menu-bridge" -B "$srcdir/menu-bridge-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DGRASSFIELD_BUILD_TESTS=ON
  cmake --build "$srcdir/menu-bridge-build"
  # Grassfield cursors (ADR-0014): hyprcursor SVG theme + XCursor fallback from branding/cursors.
  "$(_root)/branding/cursors/build.sh" --out "$srcdir/icons"

  [[ $_with_whitesur == 1 ]] || return 0
  # WhiteSur (ADR-0017): run the reviewed upstream install.sh into a scratch directory with a scratch HOME. It copies
  # folders, creates symlinks and runs gtk-update-icon-cache; it only runs while its hash is the reviewed one.
  local actual
  actual=$(sha256sum "$srcdir/whitesur-icon-theme/install.sh" | cut -d' ' -f1)
  [[ $actual == "$_whitesur_install_sha256" ]] || { echo "WhiteSur install.sh changed ($actual): review it before updating the pin" >&2; return 1; }
  install -d "$srcdir/whitesur-home" "$srcdir/whitesur-icons"
  # Clean environment: install.sh reads DESKTOP_SESSION, bold, plasma, alternative and black from it. -p ("Replaces Apple
  # logo with KDE Plasma logo") swaps only the places/ start-here logos. The guard below then FILTERS the theme (owner
  # decision 2026-10-20): it removes every icon that shows the Apple logo (perceptual match of any drawable part of any
  # SVG or embedded PNG with the reference logo masks, so a logo inside an iMac or a mouse is found, whatever the colour
  # or the path syntax), every icon of the curated blocklist (Apple trademark artwork and product silhouettes that no
  # logo detector can see: Finder, App Store, Safari, ...), the icons that share a basename with one, and the links left
  # dangling. The names it removes fall back to Adwaita and Breeze through the grassfield-icons wrapper. The build FAILS
  # when anything it knows is still present (ADR-0017). Legal review is still required before a public release.
  env -i PATH=/usr/bin HOME="$srcdir/whitesur-home" XDG_DATA_HOME="$srcdir/whitesur-home/.local/share" LC_ALL=C \
    /usr/bin/bash "$srcdir/whitesur-icon-theme/install.sh" -p -d "$srcdir/whitesur-icons" >/dev/null
  # The gtk-update-icon-cache pacman hook builds the caches on the target; these would list the removed icons.
  find "$srcdir/whitesur-icons" -name icon-theme.cache -delete
  "$startdir/whitesur-guard.sh" clean "$srcdir/whitesur-icons"
  "$startdir/whitesur-guard.sh" check "$srcdir/whitesur-icons"
}

check() {
  "$(_root)/compositor/build/grassfield-compositor-tests"
  # The peer-to-peer D-Bus case skips itself where Unix sockets cannot be created (build sandboxes).
  "$srcdir/menu-bridge-build/menu-bridge-unit-tests"
}

package_grassfield-desktop() {
  pkgdesc+=" — shell, design system, session"
  # python, librsvg (rsvg-convert) and hyprcursor (hyprcursor-util) are RUNTIME dependencies (owner decision 2026-10-19):
  # the shell runs /usr/share/grassfield/cursors/build.sh to regenerate the cursor theme for the pointer colours
  # (Settings > Accessibility > Pointer, ADR-0014) into $XDG_DATA_HOME/icons/grassfield-cursors-custom.
  depends=(hyprland uwsm quickshell qt6-declarative qt6-wayland qt6-svg inter-font kio solid kcoreaddons kservice qt6-multimedia qt6-imageformats qt6-webengine python librsvg hyprcursor)
  optdepends=(
    'grassfield-compositor: titlebars with traffic lights, minimize, global menu protocol'
    'brightnessctl: display brightness OSD and Quick Settings slider'
    'localsearch: file results in Search'
    'kio-extras: network locations and image thumbnails in Files'
    'grassfield-whitesur-icons: WhiteSur app icon theme (third party, GPL-3.0)'
  )
  local root
  root=$(_root)

  install -d "$pkgdir/usr/share/grassfield"
  cp -a --no-preserve=ownership "$root/shell" "$pkgdir/usr/share/grassfield/shell"
  find "$pkgdir/usr/share/grassfield/shell" \( -name '.qmlls.ini' -o -name '*.qmlc' \) -delete

  # Design system as a regular QML module; icons copied into the module (repo symlink resolved).
  install -d "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui"
  cp -a --no-preserve=ownership "$root/ui/Grassfield/Ui/." "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui/"
  rm -f "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui/icons"
  install -d "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui/icons"
  install -m644 "$root"/branding/icons/symbolic/*.svg "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui/icons/"

  # Grassfield.I18n -> /usr/lib/qt6/qml/Grassfield/I18n; grassfield_<lang>.qm -> /usr/share/grassfield/translations.
  DESTDIR="$pkgdir" cmake --install "$srcdir/i18n-build"

  # `qs -c grassfield` resolves configs under $XDG_CONFIG_DIRS/quickshell/<name>.
  install -d "$pkgdir/etc/xdg/quickshell"
  ln -s /usr/share/grassfield/shell "$pkgdir/etc/xdg/quickshell/grassfield"

  install -d "$pkgdir/usr/share/grassfield/hypr/grassfield"
  install -m644 "$root/config/hypr/session.lua" "$pkgdir/usr/share/grassfield/hypr/session.lua"
  install -m644 "$root"/config/hypr/grassfield/*.lua "$pkgdir/usr/share/grassfield/hypr/grassfield/"
  install -Dm644 "$root/config/defaults/grassfield.json" "$pkgdir/usr/share/grassfield/defaults/grassfield.json"
  install -Dm644 "$root/config/schema/grassfield.schema.json" "$pkgdir/usr/share/grassfield/schema/grassfield.schema.json"

  install -Dm644 "$root/packaging/wayland-sessions/grassfield.desktop" "$pkgdir/usr/share/wayland-sessions/grassfield.desktop"
  install -Dm644 "$root/packaging/systemd/grassfield-shell.service" "$pkgdir/usr/lib/systemd/user/grassfield-shell.service"
  # Omarchy's sleep-lock unit must stay inert inside the Grassfield session (the Omarchy shell it talks to is not running there).
  install -Dm644 "$root/packaging/systemd/omarchy-sleep-lock.service.d/10-grassfield.conf" \
    "$pkgdir/usr/lib/systemd/user/omarchy-sleep-lock.service.d/10-grassfield.conf"
  # Menu bridge: /usr/bin/grassfield-menu-bridge, /usr/lib/systemd/user/grassfield-menu-bridge.service,
  # /usr/share/dbus-1/interfaces/org.grassfield.MenuBridge1.xml (started by the session's autostart.lua).
  DESTDIR="$pkgdir" cmake --install "$srcdir/menu-bridge-build"

  # Grassfield Settings app (M4).
  DESTDIR="$pkgdir" cmake --install "$srcdir/settings-build"
  # Grassfield Files (M4, KIO).
  DESTDIR="$pkgdir" cmake --install "$srcdir/files-build"
  # Grassfield Preview and Glance (M4; QtPdf comes from qt6-webengine).
  DESTDIR="$pkgdir" cmake --install "$srcdir/preview-build"

  # grassfield-cursors: /usr/share/icons/grassfield-cursors/{index.theme,manifest.hl,hyprcursors,cursors}
  install -d "$pkgdir/usr/share/icons"
  cp -a --no-preserve=ownership "$srcdir/icons/grassfield-cursors" "$pkgdir/usr/share/icons/grassfield-cursors"
  install -Dm644 "$root/branding/cursors/build.sh" "$pkgdir/usr/share/grassfield/cursors/build.sh"
  install -Dm644 "$root/branding/cursors/xcursor-pack.py" "$pkgdir/usr/share/grassfield/cursors/xcursor-pack.py"
  install -Dm644 "$root/branding/cursors/cursors.tsv" "$pkgdir/usr/share/grassfield/cursors/cursors.tsv"
  install -d "$pkgdir/usr/share/grassfield/cursors/src"
  install -m644 "$root"/branding/cursors/src/*.svg.in "$pkgdir/usr/share/grassfield/cursors/src/"
  chmod 755 "$pkgdir/usr/share/grassfield/cursors/build.sh"

  # Session icon theme (ADR-0017): Grassfield's own icons first (none yet), then WhiteSur, then Adwaita and hicolor.
  # The empty scalable/apps directory is required: GTK drops a theme without a Directories entry, with its Inherits.
  install -Dm644 "$root/branding/icons/theme/index.theme" "$pkgdir/usr/share/icons/grassfield-icons/index.theme"
  install -d "$pkgdir/usr/share/icons/grassfield-icons/scalable/apps"
  # Session environment for uwsm (Grassfield desktop name only): Qt icon theme and the GTK dconf profile.
  install -Dm644 "$root/packaging/uwsm/env-grassfield" "$pkgdir/usr/share/uwsm/env-grassfield"
  install -Dm644 "$root/packaging/dconf/profile" "$pkgdir/usr/share/grassfield/dconf/profile"
  dconf compile "$srcdir/grassfield.db" "$root/packaging/dconf/grassfield.d"
  install -Dm644 "$srcdir/grassfield.db" "$pkgdir/usr/share/grassfield/dconf/grassfield.db"

  install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/grassfield/README.md"
  install -Dm644 "$root/branding/LICENSES.md" "$pkgdir/usr/share/licenses/grassfield-desktop/BRANDING.md"
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/grassfield-desktop/LICENSE"
  install -Dm644 "$root/THIRD_PARTY.md" "$pkgdir/usr/share/licenses/grassfield-desktop/THIRD_PARTY.md"
  install -Dm644 "$root/packaging/licenses/omarchy-MIT.txt" "$pkgdir/usr/share/licenses/grassfield-desktop/omarchy-MIT.txt"
}

package_grassfield-whitesur-icons() {
  pkgdesc="WhiteSur icon theme, pinned upstream commit (third party, GPL-3.0), optional app icons of the Grassfield session"
  arch=(any)
  # Upstream ships COPYING (GPL version 3, unmodified text) and no "or later" notice in any file: GPL-3.0-only.
  license=(GPL-3.0-only)
  options=(!strip)
  url="https://github.com/vinceliuice/WhiteSur-icon-theme"
  depends=()
  provides=(whitesur-icon-theme)
  conflicts=(whitesur-icon-theme whitesur-icon-theme-git)
  install -d "$pkgdir/usr/share/icons"
  cp -a --no-preserve=ownership "$srcdir/whitesur-icons/WhiteSur" "$srcdir/whitesur-icons/WhiteSur-light" \
    "$srcdir/whitesur-icons/WhiteSur-dark" "$pkgdir/usr/share/icons/"
  # Second check on the packaged tree itself (the three theme folders link into each other: checked together).
  "$startdir/whitesur-guard.sh" check "$pkgdir/usr/share/icons"
  install -Dm644 "$srcdir/whitesur-icon-theme/COPYING" "$pkgdir/usr/share/licenses/grassfield-whitesur-icons/COPYING"
  install -Dm644 "$srcdir/whitesur-icon-theme/AUTHORS" "$pkgdir/usr/share/licenses/grassfield-whitesur-icons/AUTHORS"
  printf '%s\n' "Source: https://github.com/vinceliuice/WhiteSur-icon-theme at commit ${_whitesur_commit}" \
    >"$pkgdir/usr/share/licenses/grassfield-whitesur-icons/SOURCE"
}

package_grassfield-compositor() {
  pkgdesc+=" — optional Hyprland plugin (titlebars, minimize, appmenu)"
  depends=(hyprland)
  local root
  root=$(_root)
  install -Dm755 "$root/compositor/build/grassfield-compositor.so" "$pkgdir/usr/lib/grassfield/grassfield-compositor.so"
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/grassfield-compositor/LICENSE"
  install -Dm644 "$root/THIRD_PARTY.md" "$pkgdir/usr/share/licenses/grassfield-compositor/THIRD_PARTY.md"
  install -Dm644 "$root/packaging/licenses/hyprland-BSD-3-Clause.txt" "$pkgdir/usr/share/licenses/grassfield-compositor/hyprland-BSD-3-Clause.txt"
  install -Dm644 "$root/packaging/licenses/appmenu-LGPL-2.1-or-later.txt" "$pkgdir/usr/share/licenses/grassfield-compositor/appmenu-LGPL-2.1-or-later.txt"
}
