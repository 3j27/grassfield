# Maintainer: Grassfield project
# Local package build from this repository (private project, no source download):
#   cd packaging/arch && makepkg -si        (owner runs it; installs with sudo through pacman)
# Remove: sudo pacman -Rns grassfield-desktop grassfield-compositor
# Never constrain the hyprland version here (ADR-0009, master-prompt §5.6).

pkgbase=grassfield
pkgname=(grassfield-desktop grassfield-compositor)
pkgver=0.4.0
pkgrel=1
pkgdesc="Grassfield Desktop: a polished desktop session for Omarchy (built for Omarchy, based on Arch Linux)"
arch=(x86_64)
url="https://grassfield.invalid"
# Grassfield's own code is MIT (ADR-0005, accepted by the owner 2026-10-18; root LICENSE, installed by both packages).
# Third-party notices: THIRD_PARTY.md, installed under /usr/share/licenses/<package>/.
license=(MIT)
makedepends=(cmake ninja pkgconf hyprland gtest lua extra-cmake-modules qt6-declarative qt6-tools hyprcursor librsvg python)
options=(!debug)

_root() { realpath "$startdir/../.."; }

build() {
  cmake -S "$(_root)/compositor" -B "$srcdir/compositor-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DGRASSFIELD_BUILD_TESTS=ON
  cmake --build "$srcdir/compositor-build"
  # Grassfield.I18n QML module (Translator singleton) and the compiled catalogs (translations/*.ts).
  cmake -S "$(_root)/ui/i18n" -B "$srcdir/i18n-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/i18n-build"
  cmake -S "$(_root)/apps/settings" -B "$srcdir/settings-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/settings-build"
  cmake -S "$(_root)/apps/files" -B "$srcdir/files-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/files-build"
  cmake -S "$(_root)/apps/preview" -B "$srcdir/preview-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/preview-build"
  # grassfield-menu-bridge (ADR-0008): global menus, systemd user unit, D-Bus diagnostics XML.
  cmake -S "$(_root)/bridges/menu-bridge" -B "$srcdir/menu-bridge-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DGRASSFIELD_BUILD_TESTS=ON
  cmake --build "$srcdir/menu-bridge-build"
  # Grassfield cursors (ADR-0014): hyprcursor SVG theme + XCursor fallback from branding/cursors.
  "$(_root)/branding/cursors/build.sh" --out "$srcdir/icons"
}

check() {
  "$(_root)/compositor/build/grassfield-compositor-tests"
  # The peer-to-peer D-Bus case skips itself where Unix sockets cannot be created (build sandboxes).
  "$srcdir/menu-bridge-build/menu-bridge-unit-tests"
}

package_grassfield-desktop() {
  pkgdesc+=" — shell, design system, session"
  # python, librsvg (rsvg-convert) and hyprcursor (hyprcursor-util): /usr/share/grassfield/cursors/build.sh regenerates
  # the cursor theme at runtime (custom accent or size, ADR-0014); without them only the packaged theme is available.
  depends=(hyprland uwsm quickshell qt6-declarative qt6-wayland qt6-svg inter-font kio solid kcoreaddons kservice qt6-multimedia qt6-imageformats qt6-webengine python librsvg hyprcursor)
  optdepends=(
    'grassfield-compositor: titlebars with traffic lights, minimize, global menu protocol'
    'brightnessctl: display brightness OSD and Quick Settings slider'
    'localsearch: file results in Search'
    'kio-extras: network locations and image thumbnails in Files'
  )
  local root
  root=$(_root)

  install -d "$pkgdir/usr/share/grassfield"
  cp -a "$root/shell" "$pkgdir/usr/share/grassfield/shell"
  find "$pkgdir/usr/share/grassfield/shell" \( -name '.qmlls.ini' -o -name '*.qmlc' \) -delete

  # Design system as a regular QML module; icons copied into the module (repo symlink resolved).
  install -d "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui"
  cp -a "$root/ui/Grassfield/Ui/." "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui/"
  rm -f "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui/icons"
  install -d "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui/icons"
  install -m644 "$root"/branding/icons/symbolic/*.svg "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui/icons/"

  # Grassfield.I18n -> /usr/lib/qt6/qml/Grassfield/I18n; grassfield_<lang>.qm -> /usr/share/grassfield/translations.
  DESTDIR="$pkgdir" cmake --install "$srcdir/i18n-build"

  # `qs -c grassfield` resolves configs under $XDG_CONFIG_DIRS/quickshell/<name>.
  install -d "$pkgdir/etc/xdg/quickshell"
  ln -s /usr/share/grassfield/shell "$pkgdir/etc/xdg/quickshell/grassfield"

  install -d "$pkgdir/usr/share/grassfield/hypr/grassfield"
  install -m644 "$root/config/hypr/session.lua" "$pkgdir/usr/share/grassfield/hypr/session.lua"
  install -m644 "$root"/config/hypr/grassfield/*.lua "$pkgdir/usr/share/grassfield/hypr/grassfield/"
  install -Dm644 "$root/config/defaults/grassfield.json" "$pkgdir/usr/share/grassfield/defaults/grassfield.json"
  install -Dm644 "$root/config/schema/grassfield.schema.json" "$pkgdir/usr/share/grassfield/schema/grassfield.schema.json"

  install -Dm644 "$root/packaging/wayland-sessions/grassfield.desktop" "$pkgdir/usr/share/wayland-sessions/grassfield.desktop"
  install -Dm644 "$root/packaging/systemd/grassfield-shell.service" "$pkgdir/usr/lib/systemd/user/grassfield-shell.service"
  # Menu bridge: /usr/bin/grassfield-menu-bridge, /usr/lib/systemd/user/grassfield-menu-bridge.service,
  # /usr/share/dbus-1/interfaces/org.grassfield.MenuBridge1.xml (started by the session's autostart.lua).
  DESTDIR="$pkgdir" cmake --install "$srcdir/menu-bridge-build"

  # Grassfield Settings app (M4).
  DESTDIR="$pkgdir" cmake --install "$srcdir/settings-build"
  # Grassfield Files (M4, KIO).
  DESTDIR="$pkgdir" cmake --install "$srcdir/files-build"
  # Grassfield Preview and Glance (M4; QtPdf comes from qt6-webengine).
  DESTDIR="$pkgdir" cmake --install "$srcdir/preview-build"

  # grassfield-cursors: /usr/share/icons/grassfield-cursors/{index.theme,manifest.hl,hyprcursors,cursors}
  install -d "$pkgdir/usr/share/icons"
  cp -a "$srcdir/icons/grassfield-cursors" "$pkgdir/usr/share/icons/grassfield-cursors"
  install -Dm644 "$root/branding/cursors/build.sh" "$pkgdir/usr/share/grassfield/cursors/build.sh"
  install -Dm644 "$root/branding/cursors/xcursor-pack.py" "$pkgdir/usr/share/grassfield/cursors/xcursor-pack.py"
  install -Dm644 "$root/branding/cursors/cursors.tsv" "$pkgdir/usr/share/grassfield/cursors/cursors.tsv"
  install -d "$pkgdir/usr/share/grassfield/cursors/src"
  install -m644 "$root"/branding/cursors/src/*.svg.in "$pkgdir/usr/share/grassfield/cursors/src/"
  chmod 755 "$pkgdir/usr/share/grassfield/cursors/build.sh"

  install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/grassfield/README.md"
  install -Dm644 "$root/branding/LICENSES.md" "$pkgdir/usr/share/licenses/grassfield-desktop/BRANDING.md"
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/grassfield-desktop/LICENSE"
  install -Dm644 "$root/THIRD_PARTY.md" "$pkgdir/usr/share/licenses/grassfield-desktop/THIRD_PARTY.md"
  install -Dm644 "$root/packaging/licenses/omarchy-MIT.txt" "$pkgdir/usr/share/licenses/grassfield-desktop/omarchy-MIT.txt"
}

package_grassfield-compositor() {
  pkgdesc+=" — optional Hyprland plugin (titlebars, minimize, appmenu)"
  depends=(hyprland)
  local root
  root=$(_root)
  install -Dm755 "$root/compositor/build/grassfield-compositor.so" "$pkgdir/usr/lib/grassfield/grassfield-compositor.so"
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/grassfield-compositor/LICENSE"
  install -Dm644 "$root/THIRD_PARTY.md" "$pkgdir/usr/share/licenses/grassfield-compositor/THIRD_PARTY.md"
  install -Dm644 "$root/packaging/licenses/hyprland-BSD-3-Clause.txt" "$pkgdir/usr/share/licenses/grassfield-compositor/hyprland-BSD-3-Clause.txt"
  install -Dm644 "$root/packaging/licenses/appmenu-LGPL-2.1-or-later.txt" "$pkgdir/usr/share/licenses/grassfield-compositor/appmenu-LGPL-2.1-or-later.txt"
}
