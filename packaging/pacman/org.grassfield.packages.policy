<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Grassfield Software Update's two actions, each the only way to run its helper as root through pkexec.
     - set-channel (ADR-0033 c.2, owner decision O1): grassfield-channel-set runs grassfield-channel-helper, which accepts
       only `set stable|beta`, `restore` and `off` and writes only pacman's [grassfield] configuration and trust. An
       administrator's password, kept for a few minutes.
     - update-system (ADR-0033 "Step 3", owner decision SU-M1): Update Now's grassfield-update-run runs
       grassfield-update-helper, which accepts only `run <op-id> [<migration>...]` and installs the system's update. An
       administrator's password every time, as for any system update.
     Never for an inactive or remote session. -->
<policyconfig>
  <vendor>Grassfield</vendor>
  <action id="org.grassfield.packages.set-channel">
    <description>Change where Grassfield gets its updates</description>
    <description xml:lang="fr">Changer la source des mises à jour de Grassfield</description>
    <message>Authentication is required to change where Grassfield gets its updates</message>
    <message xml:lang="fr">Une authentification est nécessaire pour changer la source des mises à jour de Grassfield</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/grassfield/grassfield-channel-helper</annotate>
  </action>
  <action id="org.grassfield.packages.update-system">
    <description>Update this computer's software</description>
    <description xml:lang="fr">Mettre à jour les logiciels de cet ordinateur</description>
    <message>Authentication is required to update this computer's software</message>
    <message xml:lang="fr">Une authentification est nécessaire pour mettre à jour les logiciels de cet ordinateur</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/grassfield/grassfield-update-helper</annotate>
  </action>
</policyconfig>
