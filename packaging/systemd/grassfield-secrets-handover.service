# The Secret Service handover of the Grassfield session (ADR-0035 D-12, owner decision Q17-b, step 2c). Started by
# config/hypr/grassfield/autostart.lua just before grassfield-shell.service: `systemctl --user start` returns once the helper
# reports ready (Type=notify), after a ksecretd left over from an earlier session has let go of org.freedesktop.secrets, so the
# shell, and any app the user opens from it, finds gnome-keyring there. At most 10 s: a slower start never holds the shell back
# (the unit then fails and the shell starts anyway). The rest (moving, once, the items libsecret clients saved in KWallet) goes on
# while the session starts, and may wait for the user's answer to KWallet's or the keychain's own password question.
[Unit]
Description=Grassfield: saved passwords stay with the keychain (once)
Documentation=file:///usr/share/doc/grassfield/README.md
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=GRASSFIELD_SESSION=1

[Service]
Type=notify
NotifyAccess=main
Slice=session.slice
ExecStart=/usr/lib/grassfield/grassfield-secrets-handover
TimeoutStartSec=10
RuntimeMaxSec=15min
TimeoutStopSec=5
# The marker ($XDG_STATE_HOME/grassfield/secrets-handover, through $STATE_DIRECTORY) is the only file it writes, readable by
# the user only; the directory gets the mode the shell gives it.
StateDirectory=grassfield
StateDirectoryMode=0700
UMask=0077
# Qt would print every D-Bus message, secrets included, to the journal.
UnsetEnvironment=QDBUS_DEBUG
# Secret values pass through its memory: never in a core file or in swap (the helper also makes itself non-dumpable).
LimitCORE=0
MemorySwapMax=0
# Hardening without namespaces (ADR-0035 decision 2c-6). In a user unit, ProtectSystem=, ProtectHome=, PrivateTmp=,
# PrivateNetwork= and the other mount, network or kernel protections make systemd add PrivateUsers=self, and a process in
# that user namespace cannot read /proc/<pid>/exe of a process outside it (EACCES): the helper could no longer tell ksecretd
# and gnome-keyring from any other owner of their names, and would never move anything. tests/shell/session_services.sh
# keeps those options out of this unit; the seccomp-based ones below need no namespace.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
MemoryMax=96M
TasksMax=16
