[Unit]
Description=Grassfield crash notifications
Documentation=file:///usr/share/doc/grassfield/README.md
# Replaces omarchy-crash-watch.service in this session (that one needs the Omarchy shell). Started by the session's autostart.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=GRASSFIELD_SESSION=1
# A unit that keeps failing stops after 5 starts in 2 minutes (the default of 5 in 10 s is never reached with this RestartSec).
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
Slice=session.slice
ExecStart=/usr/lib/grassfield/grassfield-crash-watch
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
# Hardening: it reads the journal and talks to the session bus, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
MemoryMax=128M
# Tasks: python 2 (loop + worker thread), journalctl 1, a `notify-send -w` 4 each (measured by the review; at most 2 wait for
# a click: 8), a plain notify-send up to 4, gdbus and systemd-run about 3 each for a moment (estimated): about 20 at the worst.
# The old 16 was too few for three notices at once.
TasksMax=32

[Install]
WantedBy=graphical-session.target
