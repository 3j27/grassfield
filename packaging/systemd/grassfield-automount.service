[Unit]
Description=Grassfield removable media (mounts USB drives and cards when they are connected)
Documentation=file:///usr/share/doc/grassfield/README.md
# macOS mounts connected volumes and shows them in Files; Omarchy's session starts udiskie for this and Grassfield does not
# load that autostart. udiskie only asks udisks2 over the system bus (polkit decides); it has no tray and no notifications.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=GRASSFIELD_SESSION=1
ConditionPathExists=/usr/bin/udiskie
# A unit that keeps failing stops after 5 starts in 2 minutes (the default of 5 in 10 s is never reached with this RestartSec).
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
Slice=session.slice
# ProtectSystem=strict makes /run read-only, so dconf cannot create $XDG_RUNTIME_DIR/dconf/user (92 warnings in the first real
# session). udiskie keeps no persistent settings, so GSettings uses its memory backend; the sandbox stays as it is.
Environment=GSETTINGS_BACKEND=memory
ExecStart=/usr/bin/udiskie --automount --no-notify --no-tray
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=graphical-session.target
