[Unit]
Description=Grassfield removable media (mounts USB drives and cards when they are connected)
Documentation=file:///usr/share/doc/grassfield/README.md
# macOS mounts connected volumes and shows them in Files; Omarchy's session starts udiskie for this and Grassfield does not
# load that autostart. udiskie only asks udisks2 over the system bus (polkit decides); it has no tray and no notifications.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=GRASSFIELD_SESSION=1
ConditionPathExists=/usr/bin/udiskie
# A unit that keeps failing stops after 5 starts in 2 minutes (the default of 5 in 10 s is never reached with this RestartSec).
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
Slice=session.slice
ExecStart=/usr/bin/udiskie --automount --no-notify --no-tray
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=yes
ProtectSystem=strict
# ProtectSystem=strict makes /run read-only, so dconf could not create $XDG_RUNTIME_DIR/dconf/user (92 warnings in the first
# real session). RuntimeDirectory= makes %t/dconf writable inside the sandbox AND creates it before the unit's sandbox is set up:
# the first attempt, ReadWritePaths=-%t/dconf, dropped the path when the directory did not exist yet at udiskie's start (at login
# the shell and udiskie start in the same second, before anything has made it), so the warnings came back in that session. The
# alternative, a '+' ExecStartPre that runs mkdir outside the sandbox, would run a command with no hardening at all. The directory
# is shared with the shell and every GSettings client of the session: Preserve=yes keeps it when this unit stops (the default
# removes it under the other clients), and 0700 is what dconf itself creates. udiskie's dialogs keep the user's
# real GSettings (theme, text scaling), which a memory backend would drop.
RuntimeDirectory=dconf
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0700
ProtectHome=read-only
PrivateTmp=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=graphical-session.target
