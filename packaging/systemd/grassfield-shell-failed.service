[Unit]
Description=Grassfield shell failure counter (stops a crash loop)
Documentation=file:///usr/share/doc/grassfield/README.md
# ADR-0041 step 1a (owner decision SQ-2 A): started by OnFailure= of grassfield-shell.service after every failure of the
# shell, never by the session's autostart. It counts the failures of the last 10 minutes and, at the third, cancels the
# shell's pending restart and writes the safe-mode state (packaging/bin/grassfield-shell-failed). A logout counts nothing
# (session-gone). It never unlocks: the compositor keeps a lock across the stop.
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=GRASSFIELD_SESSION=1

[Service]
Type=oneshot
Slice=session.slice
ExecStart=/usr/lib/grassfield/grassfield-shell-failed
TimeoutStartSec=20
# The script's test variables (the window, the threshold, the clock) are honoured only by the tests, which set them on a
# scratch copy: the unit clears them, so nothing in the user manager's environment can make the first crash stop the shell
# (opus security review of b1d826b, finding 3). systemd applies UnsetEnvironment= last, over the manager's environment.
UnsetEnvironment=GRASSFIELD_SHELL_FAIL_WINDOW GRASSFIELD_SHELL_FAIL_COUNT GRASSFIELD_SHELL_FAIL_NOW
# The ledger and the safe-mode state live in $XDG_RUNTIME_DIR/grassfield (0700, shared with the menu bridge, kept when
# this unit ends).
RuntimeDirectory=grassfield
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
# Hardening: it reads a few files, writes two in its runtime directory and asks the user manager to stop one unit. None of
# these options can block that request: `systemctl --user stop` talks to the user manager over its private AF_UNIX socket
# ($XDG_RUNTIME_DIR/systemd/private; AF_UNIX stays allowed, /run stays readable under ProtectSystem=strict) and needs
# nothing under /home, so ProtectHome= could even be `yes`; read-only is kept so a future reader of a user file still
# works and the setting is pinned by tests/shell/shell_failures.sh (opus security review of b1d826b, U6).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
MemoryMax=32M
TasksMax=8
