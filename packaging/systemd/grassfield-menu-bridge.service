[Unit]
Description=Grassfield menu bridge (applications' menus in the menu bar)
Documentation=file:///usr/share/doc/grassfield/README.md
# ADR-0008, master-prompt §5.8: the only Grassfield daemon. It owns com.canonical.AppMenu.Registrar only while
# grassfield-shell reports that the compositor plugin serves org_kde_kwin_appmenu, and executes nothing but
# DBusMenu calls (GetLayout, AboutToShow, Event).
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
# Only inside the Grassfield session, never in the Omarchy session (Qt/Chromium apps would hide their menus).
ConditionEnvironment=GRASSFIELD_SESSION=1

[Service]
Type=simple
Slice=session.slice
ExecStart=/usr/bin/grassfield-menu-bridge
Restart=on-failure
# Back-off between restarts (systemd >= 254): 1 s, growing to 30 s, so a crash loop cannot reach the start limit quickly.
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=30
TimeoutStopSec=5
# Socket: $XDG_RUNTIME_DIR/grassfield/menu-bridge.sock (directory 0700, socket 0600). Kept across restarts.
RuntimeDirectory=grassfield
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077

# Hardening: the session bus and its own Unix socket are all it needs.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
# Resource budget (ADR-0008: <= 20 MB RSS expected, idle CPU 0 %).
# Measured: idle ~15 MB; one 30 MB GetLayout reply peaked at 115 MB (the message is held several times while read).
# MemoryHigh throttles at 64 MB, MemoryMax = 256 MB leaves room for a reply of ~60 MB; the bridge refuses larger
# layouts after the first read and remembers an application that killed it (see Bridge::refused).
MemoryHigh=64M
MemoryMax=256M
TasksMax=16

[Install]
WantedBy=graphical-session.target
