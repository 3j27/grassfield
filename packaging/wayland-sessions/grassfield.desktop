[Desktop Entry]
Name=Grassfield
Name[fr]=Grassfield
Comment=Grassfield Desktop on Hyprland, built for Omarchy
Comment[fr]=Bureau Grassfield sur Hyprland, conçu pour Omarchy
Exec=uwsm start -e -D Grassfield:Hyprland -N Grassfield -C "Grassfield Desktop" -- start-hyprland -- --config /usr/share/grassfield/hypr/session.lua
